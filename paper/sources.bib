  title       = {An act accepting by the state of Virginia the county of Alexandria, in the District of Columbia, when the same shall be re-ceded by the congress of the United States},
  organization = {General Assembly of Virginia, session of 1845-46},
  date        = {1846-02-03},
  url         = {https://babel.hathitrust.org/cgi/pt?id=uva.x030211322&seq=56},
  urldate     = {2026-09-26},
  note        = {Ch. 64 of the Acts of the General Assembly passed at the
                 session commencing 1 December 1845 and ending 6 March 1846,
                 pp. 50-51, passed 3 February 1846. Recites the 1789 cession,
                 and provides that when Congress re-cedes the portion of the
                 District ceded by Virginia, with its jurisdiction, the same
                 shall be re-annexed to the commonwealth and constitute a
                 portion thereof, subject to such reservations respecting the
                 public property of the United States as Congress may make. It
                 is the act the act of Congress of 9 July 1846
                 (usstat1846retrocession) recites},
  annotation  = {Read 2026-09-26. Filed in Drive as "legal/state statutes/Commonwealth of Virginia 1846 - An act accepting by the state of Virginia the county of Alexandria, in the District of Columbia, when the same shall be re-ceded by the congress of the United States.pdf", a copy printed in Sally's own browser on
