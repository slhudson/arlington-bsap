@legislation{vaacts1975c636,
  title       = {Act of Mar.\ 24, 1975},
  organization = {General Assembly of Virginia, session of 1975},
  date        = {1975-03-24},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280245j&seq=401},
