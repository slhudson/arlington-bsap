@report{zilo2026,
  author      = {{Zilo International Group}},
  title       = {2026 Resident Satisfaction Survey},
  institution = {Prepared for Arlington County, Virginia},
  location    = {Centennial, Colorado},
  date        = {2026},
  annotation  = {199 pages, held in data/raw/arlington_county/survey_satisfaction_report.pdf.
                 Fielded February and March 2026; 1,613 completed surveys collected by
                 mail, online, telephone and about twenty days of in-person outreach at
                 libraries, community centres, human services sites and events, promoted
                 through civic, nonprofit, educational, business and faith-based partners.
                 The report states a 95 per cent confidence level and a margin of error of
                 approximately 2.4 per cent; that figure is the simple-random-sample
                 formula for n=1,613, and the sample it describes is self-selected, so the
                 report's own margin of error is not read here as one. The report states
                 that "don't know" responses were excluded from selected charts to keep
                 them comparable with earlier cycles, and the topline percentages take
                 non-blank responses as the denominator. Trend charts covering 2026, 2022
                 and 2018 are given for questions 1, 3, 12, 16, 17, 18 and 20 only, as
                 images whose values are not machine-readable; question 4, the form of
                 government and trust battery, carries no earlier wave. No sample weights
                 and no respondent geography appear in the report or in the response file},
}

