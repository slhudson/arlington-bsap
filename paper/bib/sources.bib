  volume      = {1975},
  pages       = {1307},
  keywords    = {datedintitle},
  shorttitle  = {Act of Mar.\ 24, 1975},
  sorttitle   = {1975-03-24},
  annotation  = {Ch. 636, Acts of the General Assembly of Virginia, session of 1975, printed pp. 1307-1309, approved 24 March 1975 [H 1110]. Read 2026-10-02. The substance is paragraph (d) of sec.
                 15.1-676, the vacancy rule. The 1958 text (vaacts1958c207), a
                 writ of election held at the next regular November election,
                 gives way to a special election for the remainder of the term
                 "not less than forty-five days and not more than sixty days
                 thereafter", with appointment by the remaining members where
                 the vacancy falls within "one hundred eighty days" of the
                 term's end. A clause for 1975 alone has the Board appoint,
                 "prior to November four, nineteen hundred seventy-five", a
                 person for the seat whose term would have expired on 31
                 December. The 1958 referendum paragraphs (e) and (f) stand,
                 the cross-references are brought to the 1962 numbering, and
                 the 1958 emergency clause is dropped. The volume's OCR does
                 not mark struck and added words, so the change is read against
                 the 1958 copy. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 1975 - Acts and Joint Resolutions, Session of 1975 (ch. 636).pdf", the page text as
                 HathiTrust umn.31951d02280245j serves it (seq 401-403), set
                 out on a plain page by code/sources/pages.py and printed on 2
                 October 2026; HathiTrust refuses an automated request, so no
                 copy of the page image was had},
}

@legislation{vaacts1993c731,
  title       = {Act of Mar.\ 28, 1993},
  organization = {General Assembly of Virginia, session of 1993},
  date        = {1993-03-28},
  url         = {https://access.heinonline.com/HOL/Page?handle=hein.ssl/ssva0049&id=1036},
  urldate     = {2026-10-07},
  titleaddon  = {ch.\ 731},
  shortjournal = {Va. Acts},
  volume      = {1993},
  pages       = {1030},
  keywords    = {datedintitle},
  shorttitle  = {Act of Mar.\ 28, 1993},
  sorttitle   = {1993-03-28},
  annotation  = {Ch. 731, Acts of the General Assembly of Virginia, session of 1993, printed pp. 1030-1033, approved 28 March 1993 [S 574], effective 1 December 1993 and only on Title 24.1's repeal and Title 24.2's enactment. The act the history line behind vacode152705 names as the one that left Arlington's board elected at large. Sec. 15.1-676, the only one of the six sections Arlington's form of government reads, drops the 1962 recodification's conditional opening - the board is elected and its vacancies filled under this section only once a majority of the voters approve it at a referendum held under a separate subsection - for a flat statement that a county "operating as of December 1, 1993, under the county manager plan" elects its board and fills vacancies as the section provides; a second, further-contingent referendum is struck with it, so both gates are gone outright, not merely softened. The vacancy machinery vaacts1975c636 wrote survives in substance: a special election "not less than forty-five days and not more than sixty days" out, or appointment by "majority vote of the remaining members" of the board "within thirty days of the occurrence" of the vacancy, "after holding a public hearing", with "the appointment shall be for the duration of the unexpired term". Struck with the referendum paragraphs is the clause unique to 1975: a one-time board appointment, before 4 November 1975, of a successor to the seat whose term would otherwise have run to the end of that December. Also struck are the 1958 referendum paragraphs on converting to four-year staggered terms (vaacts1958c207, carried forward by vaacts1975c636), with their ballot text, notice and tally-reporting procedure. The other five sections amended in the same chapter - the alternate "board of supervisors" form's election and terms (15.1-700), and vacancies in city and town councils and the office of mayor (15.1-808, 15.1-816, 15.1-830, 15.1-933) - route each body's vacancy "pursuant to Article 6" of the new Title 24.2, and do not touch Arlington's board; new sec. 15.1-760.1 sets the petition threshold for a referendum on changing a county's form of government, also untouched by Arlington's. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 1993 - Acts of Assembly, 1993 Regular Session, volume I, ch. 731.pdf", read from the page images on 2026-10-07; HeinOnline's OCR is uncorrected and was not used.},
}

