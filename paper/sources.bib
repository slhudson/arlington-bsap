@legal{samuel2026,
  author      = {Samuel, Ryan},
  title       = {Virginia Forms of Local Government},
  institution = {Office of the County Attorney, Arlington County, Virginia},
  date        = {2026-07-21},
  url         = {https://www.arlingtonva.us/files/sharedassets/public/v/1/county-board/documents/form-of-government/form-of-government-legal-research.pdf},
  urldate     = {2026-09-25},
  annotation  = {Marked "For Public Release". Written to the Board's direction
