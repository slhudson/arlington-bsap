@legislation{usstat1846retrocession,
  title       = {Act of July 9, 1846},
  organization = {United States, 29th Congress, 1st session},
  date        = {1846-07-09},
  url         = {https://www.govinfo.gov/content/pkg/STATUTE-9/pdf/STATUTE-9-Pg35.pdf},
  urldate     = {2026-09-26},
  titleaddon  = {ch.\ 35},
  shortjournal = {Stat.},
  volume      = {9},
  pages       = {35},
  keywords    = {datedintitle},
  shorttitle  = {Act of July 9, 1846},
  sorttitle   = {1846-07-09},
  annotation  = {Title: An Act to retrocede the County of Alexandria, in the District of Columbia, to the State of Virginia. The preamble recites Virginia's act of 3 February 1846 accepting the county 'when the same shall be receded by the Congress'. Sec. 1 cedes the territory and jurisdiction to Virginia 'with the assent of the people of the county and town of Alexandria', existing laws and jurisdiction to continue until Virginia provides by law for the extension of hers; sec. 2 has the sense of the people taken at a poll and proclaimed by the President. So retrocession has three dates: Virginia's acceptance in advance (3 February 1846), the act of Congress (9 July 1846) and the vote (September 1846), with Virginia's extension of her laws following (13 March 1847, not yet cited). Read 2026-09-26. Filed in sources as "legal/statutes/federal/United States 1846 - An Act to retrocede the County of Alexandria, in the District of Columbia, to the State of Virginia.pdf", saved as published
                 on 2026-09-26},
}

@legislation{vaacts1846acceptance,
  author      = {{Commonwealth of Virginia}},
  title       = {An act accepting by the state of Virginia the county of Alexandria, in the District of Columbia, when the same shall be re-ceded by the congress of the United States},
  organization = {General Assembly of Virginia, session of 1845-46},
  date        = {1846-02-03},
  url         = {https://babel.hathitrust.org/cgi/pt?id=uva.x030211322&seq=56},
  urldate     = {2026-09-26},
  note        = {Ch. 64 of the Acts of the General Assembly passed at the
                 session commencing 1 December 1845 and ending 6 March 1846,
                 pp. 50-51, passed 3 February 1846. Recites the 1789 cession,
                 and provides that when Congress re-cedes the portion of the
                 District ceded by Virginia, with its jurisdiction, the same
                 shall be re-annexed to the commonwealth and constitute a
                 portion thereof, subject to such reservations respecting the
                 public property of the United States as Congress may make. It
                 is the act the act of Congress of 9 July 1846
                 (usstat1846retrocession) recites},
  annotation  = {Read 2026-09-26. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 1846 - An act accepting by the state of Virginia the county of Alexandria, in the District of Columbia, when the same shall be re-ceded by the congress of the United States.pdf", a copy printed in Sally's own browser on
