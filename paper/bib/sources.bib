@dataset{rcva2026subgroups,
  author      = {{Ranked Choice Virginia}},
  title       = {Arlington 2025 Post-Election Survey: Answers by Group, and
                 What the Weights Do to Precision},
  publisher   = {Ranked Choice Virginia},
  date        = {2026-10-04},
  annotation  = {Two tables, held in sources/other/rcva/. The first,
                 survey_rcv_answers_by_group.csv, is 1,683 rows: one per
                 question per group category per answer, with the rollups and
                 nets the report prints. The second, survey_rcv_precision.csv,
                 is one row per group category giving Kish's effective sample
                 size, the design effect and the 95 per cent margin on a share
                 near half. Both tabulated from
                 SurveyUSA's respondent file 27714 for the Arlington County
                 2025 post-election survey of voters, fielded 6 to 13 November
                 2025, 584 completed interviews, the survey reported in
                 rcva2026evaluation. Shares are weighted with the vendor's own
                 weight, built to match Arlington's 2025 electorate on age,
                 gender and race; the targets are not in the copy we hold.
                 Each measure carries the unweighted number of respondents
                 behind it and a status - ok, caution or suppressed - so a
                 share resting on too few respondents cannot be read as one
                 that does not; a count of one to nine is hidden outright,
                 together with any other that would reveal it by subtraction,
                 so the five answer options survive only for the larger
                 categories while the share supporting survives for all.
                 Race and ethnicity are the respondent's own
                 yes or no answers and overlap, so those rows do not sum to
                 the total. The respondent file itself is not public and is
                 not in this repository: 477 of its 585 rows are unique on
                 zip, age, gender, education and tenure together, and it
                 carries interview timestamps and free-text comments. It is
                 held privately by Ranked Choice Virginia, in the repository
                 that also holds the code producing this table},
}

