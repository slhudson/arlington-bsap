}

@legislation{vaacts1982c108,
  title       = {Act of Mar.\ 25, 1982},
  organization = {General Assembly of Virginia, session of 1982},
  date        = {1982-03-25},
  url         = {https://access.heinonline.com/HOL/Page?handle=hein.ssl/ssva0090&id=347},
  urldate     = {2026-10-07},
  titleaddon  = {ch.\ 108},
  shortjournal = {Va. Acts},
  volume      = {1982},
  pages       = {221},
  keywords    = {datedintitle},
  shorttitle  = {Act of Mar.\ 25, 1982},
  sorttitle   = {1982-03-25},
  annotation  = {Ch. 108, Acts of the General Assembly of Virginia, session of 1982, printed pp. 221-222, approved 25 March 1982 [H 252]. Softens the non-interference bar vaacts1952c443 wrote and vaacts1962c623 carried unchanged, reading today's sec. 15.2-703 into place. Sec. 15.1-675 strikes the opening exception for the board's own appointees, and narrows the bar from directing or requesting an appointment, or taking any part in one, to acting "in any manner dictate" an appointment or removal, dropping the clause naming a member's own removal from office or employment and the clause barring any part in an appointment. A sentence is added letting the board express its views and "fully and freely discuss with the manager" anything touching appointment and removal of such officers and employees. The inquiry exception widens to investigation, and the board now deals through the manager with "county officers and employees who are subject to the direction and supervision of the manager" rather than the administrative services alone; the clause naming the heads of departments the board may appoint is struck. Last, the closing sentence making a violation a misdemeanor costing the member his office is struck outright: no penalty survives in the section. All four changes session-acts-1982-c108 asked about - requesting no longer barred, taking any part no longer barred, the discussion carve-out added, the misdemeanor and forfeiture gone - are this act's, not the 1997 recodification's. The same chapter amends sec. 15.1-675.1, the clerk of the county board's appointment and duties, and sec. 15.1-683, certification and payment of payrolls, dropping the requirement that payments be certified back to the board for adoption or rejection, and adds sec. 15.1-687.3 letting a board of supervisors establish a local human rights commission by ordinance; none of the three touches the bar. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 1982 - Acts of Assembly, 1982 Regular Session, Volume I, ch. 108.pdf", read from the page images on 2026-10-07; HeinOnline's OCR is uncorrected and was not used.},
}

@legislation{vaacts1975c517,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1975 (ch. 517 excerpt)},
  organization = {General Assembly of Virginia, session of 1975},
  date        = {1975-03-22},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280245j&seq=166},
  urldate     = {2026-10-01},
  note        = {Ch. 517, Acts of the General Assembly of Virginia, session of
                 1975, printed pp. 1072 and 1083, approved 22 March 1975 [S
                 744]},
  annotation  = {A statewide housekeeping act, read to dispose of the suspicion
                 that 1975 was a significant year for this chapter. It amends
                 and reenacts forty-six sections across the Code "relating to
                 referendums and special elections", and sec. 15.1-676 is one
                 of them - the section that had carried Arlington's board-size
                 and four-year-term referendum since vaacts1952c591. What is
                 reproduced is the same machinery: "Notwithstanding the
                 provisions of §§ 15.1-674 and 15.1-694, if, in any county
                 operating under the county manager plan provided for in this
                 chapter, a majority of the qualified voters voting on the
                 question submitted in the election held as provided in
                 paragraph (e) of this section shall vote in favor of the
                 election of the members of the county board", with the section
                 now carrying the catchline "Election of members of county
                 board; filling vacancies". The window the paragraph refers to
                 had closed in 1958 (vaacts1958c207) and nobody had ever
                 petitioned under it, so the Code still carried a dead
                 referendum twenty-three years after it was first offered. The
                 act changes nothing substantive here. Filed in sources as
                 "legal/statutes/state/Commonwealth of Virginia 1975 - Acts and Joint Resolutions, Session of 1975 (ch. 517 excerpt).pdf", the
                 page text as HathiTrust umn.31951d02280245j serves it, set out
                 on a plain page by code/sources/pages.py and printed on 1
                 October 2026; HathiTrust refuses an automated request, so no
                 copy of the page image was had.},
}

@online{arlingtonva2026members,
  author      = {{Arlington County Board}},
  title       = {Historical Members: 1932 -- Present},
  organization = {Arlington County, Virginia},
  url         = {https://www.arlingtonva.us/Government/Departments/County-Board/County-Board-Members/Historical-Members-1932-Present},
  urldate     = {2026-10-01},
  annotation  = {The county's own roll of the County Board, one entry per year from 1932
                 to the current year, each member named with the office held that year and
                 with arrivals and departures dated to the day: ``Resigned 12/14/95'',
                 ``Special Election 1/30/96: Replaced Mary Margaret Whipple'', ``Appointed
                 on 7/15/2023 to fill seat vacated by Katie Cristol''. It records service
                 rather than contests, so it is the only source held here that witnesses a
                 member seated without winning an election. The page gives no date of
                 its own and is revised as the Board changes; the copy in
                 sources/government/local/arlington_county/ is the page as printed on 1 October 2026.
                 Each decade sits in a collapsed accordion and the server refuses curl,
                 so the copy is printed by headless Chrome, which expands every panel.
                 Five of its entries are wrong, each checked against novack1994 and
                 listed on county-corrections: it carries the county's own spelling
                 ``Lucas H. Bleviins'' at 1957; lists F. Freeland Chew twice at 1941 and
                 Mary Margaret Whipple twice at 1986, leaving out Elizabeth B. Magruder
                 and John G. Milliken; dates Howard Massey's appointment to 10 November
                 1952 where dailysun1952appointees names him among the three appointed
                 that September; and gives John W. Purdy the title Vice-President at
                 1977. It also interleaves notes about the Board's clerk into the member
                 column at 1971, 1982, 1989, 1994 and 2000 The Board elects its chair and vice-chair at its first meeting of the year; the roll names the chair of every year from 1932 and the vice-chair from 1967, read into data/clean/members_chairs.csv. Since 1990 each year's vice-chair is the next year's chair, with four breaks each explained by the Board's own membership (Hunter ahead of Bozman in 1996; Monroe leaving in January 2003; Tejada's term ending in December 2015; Gutshall leaving in April 2020).},
}

