@legislation{usstat1846retrocession,
  author      = {{United States}},
  title       = {An Act to retrocede the County of Alexandria, in the District of Columbia, to the State of Virginia},
  organization = {29th Congress, 1st session},
  date        = {1846-07-09},
  url         = {https://www.govinfo.gov/content/pkg/STATUTE-9/pdf/STATUTE-9-Pg35.pdf},
  urldate     = {2026-09-26},
  note        = {9 Stat. 35, ch. 35, approved 9 July 1846. The preamble recites
                 Virginia's act of 3 February 1846 accepting the county 'when
                 the same shall be receded by the Congress'. Sec. 1 cedes the
                 territory and jurisdiction to Virginia 'with the assent of the
                 people of the county and town of Alexandria', existing laws
                 and jurisdiction to continue until Virginia provides by law
                 for the extension of hers; sec. 2 has the sense of the people
                 taken at a poll and proclaimed by the President. So
                 retrocession has three dates: Virginia's acceptance in advance
                 (3 February 1846), the act of Congress (9 July 1846) and the
                 vote (September 1846), with Virginia's extension of her laws
                 following (13 March 1847, not yet cited)},
  annotation  = {Read 2026-09-26. Filed in Drive as "legal/federal statutes/United States 1846 - An Act to retrocede the County of Alexandria, in the District of Columbia, to the State of Virginia.pdf", saved as published
                 on 2026-09-26},
}

@legislation{vaacts1846acceptance,
