  sortname    = {{Daily Sun}},
}

@article{dailysun1951policechief,
  title       = {Applications For Police Chief Post Being Received (28 November
                 1951, p. 1)},
  journaltitle = {Daily Sun},
  location    = {Arlington, Va.},
  date        = {1951-11-28},
  pages       = {1},
  url         = {https://virginiachronicle.com/?a=d&d=TDS19511128.1.1},
