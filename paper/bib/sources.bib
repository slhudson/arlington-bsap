% Dillon's Rule in Virginia is judge-made: the Supreme Court of Appeals took
% Dillon's canon of strict construction from his treatise in 1882 and quoted it
% outright in 1896. It was never legislated and is not in the constitution.
% Entered as @jurisdiction for the reason given below.
@jurisdiction{kirkhamvrussell1882,
  title       = {Kirkham v. Russell},
  date        = {1882-12-19},
  url         = {https://www.courtlistener.com/opinion/6911713/kirkham-v-russell/},
  urldate     = {2026-09-30},
  journaltitle = {Va.},
  volume      = {76},
  pages       = {956},
  sortname    = {{Kirkham v. Russell}},
  annotation  = {Lewis, J. Seven men whom Petersburg's outgoing common council
                 elected to city offices three days before eleven of its
                 twenty-four members left office petitioned for mandamus to
                 compel the city auditor to pay their salaries; the writs were
                 refused, the ordinance under which they were elected being an
                 unreasonable exercise of the council's power and the council's
                 power of election already spent. Holds, 76 Va. at 961, citing
                 Dillon on Municipal Corporations sec. 91 (3rd ed.), that "in
                 the construction of charters of corporations, whether public
                 or private, it is a settled rule of interpretation ... that
                 only such powers can be exercised under them as are clearly
                 comprehended within the words of the charter, or derived
                 therefrom by necessary implication, regard being had to the
                 objects of the grant. And any doubt arising out of the terms
                 used by the legislature must be resolved in favor of the
                 public." schragger2022 note 79 reads this as the point at
                 which Virginia adopted Dillon's Rule in full, rejecting the
                 contrary doctrine of Cooley that the court had followed in
                 Ould & Carrington v. City of Richmond, 64 Va. 464 (1873).
                 Filed in sources as "legal/cases/Supreme Court of Appeals of Virginia 1882 - Kirkham v. Russell.pdf", the Harvard Caselaw Access
                 Project scan of 76 Va. 956 and the pages that follow it in the
                 volume, as CourtListener serves it, saved 30 September 2026},
}

@jurisdiction{winchestervredmond1896,
  title       = {City of Winchester v. Redmond},
  date        = {1896-11-19},
  url         = {https://www.courtlistener.com/opinion/6914215/city-of-winchester-v-redmond/},
  urldate     = {2026-09-30},
  journaltitle = {Va.},
  volume      = {93},
  pages       = {711},
  origlocation = {25 S.E. 1001},
  sortname    = {{City of Winchester v. Redmond}},
  annotation  = {Riely, J.; reversed. Winchester's common council had offered a
                 standing $500 reward for the apprehension and conviction of
                 incendiaries, and Redmond, having secured two convictions,
                 sued the city for it. Holds, 93 Va. at 714, quoting Dillon on
                 Municipal Corporations sec. 89 (3rd ed.), that a municipal
                 corporation has only "those granted in express words", those
                 "necessarily or fairly implied in or incident to the powers
                 expressly granted", and those "essential to the declared
                 objects and purposes of the corporation, not simply
                 convenient, but indispensable", and that "Any fair, reasonable
                 doubt concerning the existence of power is resolved by the
                 courts against the corporation, and the power is denied." The
                 city had no such power: crime is an offence against the State,
                 and the charter's general clause letting the council "do all
                 such things as it may deem proper for the prosperity, quiet,
                 and good order of the city" is confined to "the ordinary
                 objects and purposes of municipal corporations". schragger2022
                 note 79 names this as the case in which the court "directly
                 quoted what we know as Dillon's Rule". Filed in sources as
                 "legal/cases/Supreme Court of Appeals of Virginia 1896 - City of Winchester v. Redmond.pdf", the Harvard Caselaw Access Project
                 scan of 93 Va. 711 as CourtListener serves it, saved 30
                 September 2026},
}

@article{schragger2022,
  author      = {Schragger, Richard and Retzloff, C. Alex},
  title       = {The Failure of Home Rule Reform in Virginia: Race, Localism,
                 and the Constitution of 1971},
  journaltitle = {Journal of Law and Politics},
  volume      = {37},
  date        = {2022},
  pages       = {183--215},
  url         = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3574765},
  urldate     = {2026-09-30},
  annotation  = {Read 30 September 2026. The Commission on Constitutional
                 Revision's 1969 draft included the provision, quoted at 183
                 from the Commission's report, that "a charter county or a city
                 may exercise any power or perform any function which is not
                 denied to it by this Constitution, by its charter, or by laws
                 enacted by the General Assembly"; it was dropped before the
                 draft reached the voters in 1970. At 205, quoting the House of
                 Delegates committee report: "The committee does not recommend
                 a constitutional provision proposed by the Commission to
                 reverse the so-called 'Dillon' rule of strict construction of
                 municipal powers. The first sentence of Section 3 as
                 introduced, therefore, has been deleted. The Municipal League
                 also told the committee it was against this change because, as
                 a matter of experience it felt the General Assembly had
                 granted to cities the powers they need and desire." The
                 opposition was the Virginia Municipal League's, described at
                 200 as "somewhat counterintuitive"; the Virginia Association
                 of Counties' executive board had proposed the opposite in
                 1968, that localities be given every power not denied them
                 (note 102), and reversed its later hostility only in its 2020
                 legislative program (note 174). At 195-96 and notes 79-80: the
                 court took Dillon's canon of strict construction in
                 kirkhamvrussell1882 and quoted it outright in
                 winchestervredmond1896, and the rule "has now been the law of
                 Virginia for 140 years". At 205-08 the authors place the
                 rejection in the racial politics of the moment, Richmond
                 turning majority-Black while white suburban and rural leaders
                 were wary of empowered cities, and note that in 1969 one of
                 the hundred delegates was African-American. Filed in sources as
                 "academic/journal_of_law_and_politics/Schragger and Retzloff 2022 - The Failure of Home Rule Reform in Virginia.pdf", the journal's own PDF saved 30
                 September 2026},
}

