@article{sun1951rulingboard,
  title       = {Board Wins Ruling Affirming Power to Appoint Heads of
                 Departments},
  journaltitle = {Sun},
  location    = {Arlington, Va.},
  date        = {1951-03-23},
  pages       = {1},
  url         = {https://virginiachronicle.com/?a=d&d=TSU19510323.1.1},
  urldate     = {2026-10-02},
  annotation  = {The 1951 ruling, reported three days after it was handed down
                 on Tuesday 20 March. The Board won. Judge Walter T. McCarthy
                 "ruled Tuesday that appointment of Arlington department heads
                 rests with the County Board", on a petition for a declaratory
                 judgment filed by Commonwealth's Attorney Denman T. Hucker
                 "after the Board, by resolution in January, reclaimed the
                 appointive power from the manager". The Board, represented by
                 Malcolm D. Miller and Benjamin M. Hedrick, had the manager law
                 read for it: "After establishment of the county manager system
                 here and until 1937, the Board appointed the department
                 heads. In 1937 it delegated that authority to the county
                 manager. The Board had no right to relinquish its power in
                 1937, Judge McCarthy said in his ruling, declaring a change in
                 procedure could be accomplished only through an amendment to
