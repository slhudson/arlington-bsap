@legislation{vaacts1962c623,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1962 (ch. 623 excerpt)},
  organization = {General Assembly of Virginia, session of 1962},
  date        = {1962-04-07},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280229h&seq=1096},
  urldate     = {2026-10-01},
  note        = {Ch. 623, Acts of the General Assembly of Virginia, session of
                 1962, printed pp. 1092-1096; the recodification of Title 15 as
                 Title 15.1},
  annotation  = {The recodification of Title 15 as Title 15.1, and the page
                 that shows the non-interference bar was not softened in 1962.
                 Sec. 15.1-675 carries the text of vaacts1952c443 word for
                 word: "Except as to persons appointed by it, neither the
                 county board nor any of its members shall direct or request
                 the appointment of any person to or his removal from any
                 office or employment by the county or in any way take part in
                 the appointment of or removal of officers and employees of the
                 county", dealing with the administrative services "solely
                 through the county manager", no orders "either publicly or
                 privately to any other county employee", and "Any member
                 violating the provisions of this section shall be guilty of a
                 misdemeanor and upon conviction thereof shall forfeit his
                 office." Sec. 15.1-674 carries the Board's composition in its
                 familiar form - "a board of five members to be known as the
                 county board", four-year terms, a chairman elected annually
                 "with a vote but no veto" - and sec. 15.1-676 still carries
                 the 1952 referendum machinery of vaacts1952c591, ten years
                 after its window closed. Since the codification history of
                 today's sec. 15.2-703 runs 1952 c. 443, 1962 c. 623, 1982 c.
                 108, 1997 c. 587, and 1971 did not touch the section
                 (vaacts1971exsess), the softening is 1982 c. 108 or the 1997
                 recodification. Three pages on the county attorney
                 referendum of vaacts1952c569 answer whether a later session
                 reopened it the way 1954 (vaacts1954c151) and 1958
                 (vaacts1958c207) reopened the election question: it was not.
                 Sec. 15.1-680 carries the 1952 act's text forward essentially
                 unchanged, opening "(1) In the year nineteen hundred
                 fifty-two there may in any county adopting the form of
                 organization and government provided for in this article be
                 a referendum on the following questions", with the same two
                 questions, the same thirty-five-hundred-to-six-thousand-
                 dollar range, the same one-year appointment without renewal,
                 and the same bar on the county attorney bringing suit. The
                 section sits between sec. 15.1-679 (the county manager's
                 referendum, vaacts1952c198) and sec. 15.1-681 (the board's
                 investigative power, vaacts1952c162) in an unbroken run from
                 sec. 15.1-674, so nothing was dropped from the 1952 package
                 at this recodification; the "in the year nineteen hundred
                 fifty-two" clause was carried over unamended rather than
                 brought forward the way 15.1-676(e) was rewritten with 1958
                 dates. No chapter amending sec. 15.1-680 after 1962 is
                 known, and no section of today's Title 15.2, chapter 7
                 traces to Code 1950 sec. 15-352.3 the way sec. 15.2-707,
                 15.2-708 and 15.2-709 trace to its neighbors sec. 15-352.1,
                 15-352.2 and 15-352.4 - consistent with the provision
                 lapsing at the 1997 recodification rather than being
                 reopened, though that recodification act itself has not
                 been read. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 1962 - Acts and Joint Resolutions, Session of 1962 (ch. 623 excerpt).pdf" (p. 1092)
                 and "legal/statutes/state/Commonwealth of Virginia 1962 - Acts and Joint Resolutions, Session of 1962 (ch. 623 excerpt, county attorney).pdf" (pp. 1092-1096, superseding
                 the first for everything it covers), the page text as
                 HathiTrust umn.31951d02280229h serves it, set out on a plain
                 page by code/sources/pages.py and printed on 1 October 2026
                 and 2 October 2026; HathiTrust refuses an automated request,
                 so no copy of the page image was had.},
}

@legislation{richland1958charter,
  author      = {{Richland Freeholder's Charter Committee}},
  title       = {Charter of the City of Richland, Washington},
  organization = {City of Richland, Washington},
  date        = {1958-09-17},
  url         = {https://babel.hathitrust.org/cgi/pt?id=uiug.30112060126957&seq=20},
  urldate     = {2026-10-01},
  note        = {Sections 4.04 and 4.05, printed p. 12. Prepared by the
                 Richland Freeholder's Charter Committee elected 15 July 1958,
                 approved by the committee 17 September 1958 and submitted to
                 the Board of County Commissioners of Benton County,
                 Washington, the next day},
  annotation  = {The earliest located instance of the carve-out Arlington's
                 sec. 15.2-703 carries today. Section 4.05, "Council not to
                 Interfere", in full: "Neither the Council nor any of its
                 members shall direct or request the appointment of any person
                 to, or his removal from, any office or position by the Manager
                 or by any of his subordinates, but the Council while in
                 official session, open or executive, may express its views and
                 fully and freely discuss with the Manager anything pertaining
                 to appointment and removal of City officers and employees.
                 Except for the purpose of inquiry, the Council and its members
                 shall deal with the administrative branch solely through the
                 Manager, and neither the Council nor any member thereof shall
                 give orders to any subordinate of the Manager, either publicly
                 or privately." What matters is the pairing: Richland keeps the
                 strict verb of the National Municipal League's model
                 (nml1916modelcharter) and of vaacts1952c443 - "direct or
                 request" - and adds the carve-out to it. Arlington today has
                 the carve-out, the weaker verb and no penalty, which is the
                 softest of the three combinations. Section 4.04 gives the
                 Manager power to "Appoint, and when he deems the best
                 interests of the City require, remove officers and employees
                 of the City". This copy is the charter as proposed, not as
                 adopted. Filed in sources as "legal/statutes/state/Richland Freeholder's Charter Committee 1958 - Charter of the City of Richland, Washington.pdf", the page text as HathiTrust
                 uiug.30112060126957 serves it, set out on a plain page by
                 code/sources/pages.py and printed on 1 October 2026.},
}

@article{dailysun1951institute,
  title       = {Childs Tells League 4 County Elective Offices Should Be Under
                 Manager, County Board (1 October 1951, p. 1)},
  journaltitle = {Daily Sun},
  location    = {Arlington, Va.},
  date        = {1951-10-01},
  pages       = {1},
  url         = {https://virginiachronicle.com/?a=d&d=TDS19511001.1.1},
  urldate     = {2026-10-01},
  annotation  = {The meeting the 1952 package came out of: the third annual
                 Institute on Local Government, held the Saturday before under
                 the auspices of the Arlington League of Women Voters at
                 Stratford Junior High School, "175 people attending". It is
                 not, as a later summary has it, a meeting of the Citizens
                 Advisory Committee on Organization and Procedure; that
                 committee appears here only as a speaker's affiliation. Dr.
                 Richard S. Childs, "chairman of the executive committee of the
                 National Municipal League", proposed putting the treasurer,
                 commissioner of revenue, sheriff and county clerk under the
                 Manager and the Board, calling those offices "those little
                 islands of power" and saying "they are technical jobs and
                 should be done by people responsible to the manager"; he also
                 recommended a non-partisan ballot for Board elections and
                 "urged clarification of the relationship between the County
                 Board and the manager". That puts the author of the model
                 charter Arlington's non-interference bar was drawn from
                 (nml1916modelcharter) in the room four months before the
                 session that enacted it. Mrs. Harold Stone, former national
                 vice-president of the League of Women Voters, listed the
                 proposals to go to the General Assembly: "appointment of the
                 manager to an indefinite tenure instead of the annual
                 appointment: the power to appoint department heads should be
                 given to the manager rather than the County Board, and the
                 creation of the office of county attorney as a legal counsel
                 separate from the office of Commonwealth's Attorney" - which
                 are vaacts1952c198 and vaacts1952c569. Harley Williams, of the
                 Arlington Civic Federation's local government committee, "said
                 that the County Board should be given the power to issue
                 subpoenas in conducting investigations", which is
                 vaacts1952c162. Attorney William Winston, of the Citizens
                 Advisory Committee on Organization and Procedure, described
                 the civil service act's competitive and non-competitive
                 classes and "said he opposed making it a crime for county
                 employes" to express their political opinions. Edmund D.
                 Campbell, former chairman of the county board, proposed ending
                 annual Board elections and charged that the present board
                 assumed more authority than the manager statute intends; Dr.
                 George Spicer of the University of Virginia said the authority
                 of the Board and the manager under State law "are without
                 meaning, perplexing and contradictory". Mrs. George Vietheer,
                 president of the Arlington League, presided at the morning
                 session; she filed the referendum petition ten months later
                 (dailysun1952petitions). Board size and the election cycle are
                 not on anyone's list here. Filed in sources as "press/arlington_daily_sun/Daily Sun 1951 - Childs Tells League 4 County Elective Offices Should Be Under Manager, County Board (1 October 1951, p. 1).pdf", the page text as Virginia Chronicle serves it at
                 f=XML, set out on a plain page by code/sources/pages.py and
                 printed on 1 October 2026; the site refuses an automated
                 request and its page images are behind a login, so no copy of
                 the image was had, and the OCR is poor enough in places that
                 it is quoted here as it stands.},
  sortname    = {{Daily Sun}},
}

@article{dailysun1951lundberg,
  title       = {Board Member For Manager Charge Made (29 October 1951, p. 1)},
  journaltitle = {Daily Sun},
  location    = {Arlington, Va.},
  date        = {1951-10-29},
  pages       = {1},
  url         = {https://virginiachronicle.com/?a=d&d=TDS19511029.1.1},
  urldate     = {2026-10-01},
  annotation  = {The fight over the Manager's job, three months before the
                 session. At the Saturday Board meeting Daniel A. Dugan moved
                 "that County Manager A. T. Lundberg be given notice of his
                 discharge as of January 1, 1952"; he "was overruled, 4 to 1,
                 as the other board members defended the county manager and the
                 record of Public Safety Dldector Carlisle Johnstone, both of
                 whom had been under fire from Mr. Dugan" (the paper's misprint
                 for Director). Robert W. Cox said he believed Lundberg "should
                 and would resign anyway if he doesn't 'see eyt to eye' with
                 the board after January 1, when at least one new board member
                 win take office". F. Freeland Chew charged that "There is a
                 movement in Arlington to make a certain member af the County
                 Board county manager", said he "could name the board member
                 who would become county manager under the new movement and
                 could predict the new manager's choice for police chief, which
                 office now is vacant", and that "This movement took root about
                 two years ago In a portion of a well known Arlington
                 organization" with "a meeting was held two weeks ago"; he
                 added that he had no evidence Dugan was part of it. The Board
                 then gave Lundberg "a vote of confidence and a new contract
                 for the year, 1952", on Alfred E. Frisbie's motion seconded by
                 the chairman, Mrs. Florence Cannon. That annual contract is
                 the arrangement vaacts1952c198 offered to replace, and the
                 voters did on 4 November 1952 (dailysun1952results). Filed in
                 sources as "press/arlington_daily_sun/Daily Sun 1951 - Board Member For Manager Charge Made (29 October 1951, p. 1).pdf", the page
                 text as Virginia Chronicle serves it at f=XML, set out on a
