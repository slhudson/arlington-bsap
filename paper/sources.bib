@legislation{vaacts1975c517,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1975 (ch. 517 excerpt)},
  organization = {General Assembly of Virginia, session of 1975},
  date        = {1975-03-22},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280245j&seq=166},
  urldate     = {2026-10-01},
  note        = {Ch. 517, Acts of the General Assembly of Virginia, session of
                 1975, printed pp. 1072 and 1083, approved 22 March 1975 [S
                 744]},
  annotation  = {A statewide housekeeping act, read to dispose of the suspicion
                 that 1975 was a significant year for this chapter. It amends
                 and reenacts forty-six sections across the Code "relating to
                 referendums and special elections", and sec. 15.1-676 is one
                 of them - the section that had carried Arlington's board-size
                 and four-year-term referendum since vaacts1952c591. What is
                 reproduced is the same machinery: "Notwithstanding the
                 provisions of §§ 15.1-674 and 15.1-694, if, in any county
                 operating under the county manager plan provided for in this
                 chapter, a majority of the qualified voters voting on the
                 question submitted in the election held as provided in
                 paragraph (e) of this section shall vote in favor of the
                 election of the members of the county board", with the section
                 now carrying the catchline "Election of members of county
                 board; filling vacancies". The window the paragraph refers to
                 had closed in 1958 (vaacts1958c207) and nobody had ever
                 petitioned under it, so the Code still carried a dead
                 referendum twenty-three years after it was first offered. The
                 act changes nothing substantive here. Filed in Drive as
                 "legal/state statutes/Commonwealth of Virginia 1975 - Acts and
                 Joint Resolutions, Session of 1975 (ch. 517 excerpt).pdf", the
                 page text as HathiTrust umn.31951d02280245j serves it, set out
                 on a plain page by code/sources/pages.py and printed on 1
                 October 2026; HathiTrust refuses an automated request, so no
                 copy of the page image was had.},
}

@online{arlingtonva2026members,
