@phdthesis{bestebreurtje2017,
  author      = {Bestebreurtje, Lindsey},
  title       = {Built by the People Themselves: African American Community Development in Arlington, Virginia, from the Civil War through Civil Rights},
  type        = {PhD dissertation},
  institution = {George Mason University},
  date        = {2017},
  url         = {https://hdl.handle.net/1920/11125},
  urldate     = {2026-09-24},
  annotation  = {The dissertation, distinct from the 2024 book of the same
                 title and from the digital exhibit of the same title at
                 lindseybestebreurtje.org, which its own About page calls a
                 piece of the book. Author, title, degree, institution and
                 year are read from the dissertation's own title page; the
                 defence was 27 March 2017. George Mason's repository holds it
                 as Bestebreurtje_gmu_0883E_11369.pdf under handle 1920/11125.
                 The copy held is a 443-page PDF whose metadata dates it 30
                 March 2017; page numbers cited are the printed ones (printed
                 p.215 is PDF page 227). Printed
                 p.215 names the November 1931 candidates, Vollin for sheriff
                 and Harris, Morton and Mosley for the County Board, citing the
                 county's candidate list as Anderson reprints it (anderson1958
                 p.67); pp.217-218 say it was fifty years before another
                 African American candidate ran for office in Arlington; p.307
                 repeats the four in note 815. The text was read for the
                 growth of 1930-1950 and the fall in the Black share: p.233
                 says the fall in the Black share was no exodus but a steady
                 Black population beside white arrivals drawn by suburban land
                 booms and federal employment; pp.239-240 give the federal
                 influx under the New Deal and the 1940s militarization, and
                 57,000 (1941), 120,000 (1945) and 135,000 (1950), citing
                 Rose; p.242 says the arrivals were overwhelmingly white and
                 that Black residents who arrived in the Great Migration were
                 12 per cent of Arlington's Black population in 1940; p.248
                 calls Arlington the fastest-growing county from 1930 to 1950;
                 pp.249-250 give the Zoning Ordinance of 1930 and road over rail
                 access. pp.42-43 tie the streetcar suburbs to the era before
                 1930. Filed in sources as
                 "academic/george_mason_university/Bestebreurtje 2017 - Built By the People Themselves.pdf"},
}

