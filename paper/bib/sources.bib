@online{mggg2021portland,
  author      = {{MGGG Redistricting Lab}},
  title       = {Analysis of Election Systems for the Portland, OR City Council},
  date        = {2021-07-23},
  url         = {https://mggg.org/publications/Portland.pdf},
  urldate     = {2026-10-07},
  annotation  = {Portland's five-member council is elected at large; the POC
                 share of CVAP is 22.18 percent (p. 1). 100,000-step ReCom
                 ensembles for 5-, 7- and 9-district councils found a highest-
                 POC-CVAP district of 34.0, 36.3 and 35.6 percent, none near a
                 majority (p. 4). Simulated ranked-choice (STV) elections elect
                 1-2 POC-preferred candidates to a 5-member council, 1-3 to a
                 7-member and 2-4 to a 9-member; districts elect none (Table 9,
                 p. 18). Report of the MGGG Redistricting Lab, Tufts
                 University; the lab is now the Data and Democracy Lab at the
                 University of Chicago. PDF pages are printed page plus one.
                 Read 2026-10-07. Filed in sources as "academic/data_and_democracy_lab/MGGG Redistricting Lab 2021 - Analysis of Election Systems for the Portland, OR City Council.pdf", saved as published on
                 2026-10-07},
}

@online{mggg2020yakima,
