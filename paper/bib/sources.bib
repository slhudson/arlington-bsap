@legislation{usstat1790residence,
  title       = {Act of July 16, 1790},
  organization = {United States, 1st Congress, 2nd session},
  date        = {1790-07-16},
  titleaddon  = {ch.\ 28},
  shortjournal = {Stat.},
  volume      = {1},
  pages       = {130},
  keywords    = {datedintitle},
  shorttitle  = {Act of July 16, 1790},
  sorttitle   = {1790-07-16},
  url         = {https://www.govinfo.gov/content/pkg/STATUTE-1/pdf/STATUTE-1-Pg130.pdf},
  urldate     = {2026-10-07},
  annotation  = {Title: An Act for establishing the temporary and permanent
                 seat of the Government of the United States. Sec. 1 accepts "a district of territory", "not exceeding ten miles square", on the
                 Potomac "for the permanent seat of the government of the
                 United States", the laws of the state within it to continue
                 until the government moves there, which sec. 6 fixes for the
                 first Monday in December 1800. The act names no county on the
                 Virginia side; that part of the district becomes the county of
                 Alexandria only in the act of February 27, 1801
                 (usstat1801organic). The copy is the one page of the Statutes
                 at Large the act occupies. Read 2026-10-07. Filed in sources as "legal/statutes/federal/United States 1790 - An Act for establishing the temporary and permanent seat of the Government of the United States.pdf", saved as published on 2026-10-07},
}

@legislation{usstat1801organic,
  title       = {Act of Feb.\ 27, 1801},
  organization = {United States, 6th Congress, 2nd session},
  date        = {1801-02-27},
  titleaddon  = {ch.\ 15},
  shortjournal = {Stat.},
  volume      = {2},
  pages       = {103},
  keywords    = {datedintitle},
  shorttitle  = {Act of Feb.\ 27, 1801},
  sorttitle   = {1801-02-27},
  url         = {https://www.govinfo.gov/content/pkg/STATUTE-2/pdf/STATUTE-2-Pg103-3.pdf},
  urldate     = {2026-10-07},
  annotation  = {Title: An Act concerning the District of Columbia. Sec. 1
                 continues the laws of Virginia in the part of the district
                 Virginia ceded; sec. 2 forms the district "into two counties",
                 the part "on the west side of said river" to "be called the
                 county of Alexandria"; sec. 3 and after create the circuit
                 court of the District of Columbia and its judges, and sec. 11
                 the justices of the peace the President appoints. The county
                 of Alexandria is the land this report follows: all of today's
                 Arlington County and the part of the City of Alexandria that
                 lay in the district. The copy is the whole act, 2 Stat.
                 103-108. Read 2026-10-07. Filed in sources as "legal/statutes/federal/United States 1801 - An Act concerning the District of Columbia.pdf", saved as published on 2026-10-07},
}

@legislation{usstat1801supplementary,
  title       = {Act of Mar.\ 3, 1801},
  organization = {United States, 6th Congress, 2nd session},
  date        = {1801-03-03},
  titleaddon  = {ch.\ 24},
  shortjournal = {Stat.},
  volume      = {2},
  pages       = {115},
  keywords    = {datedintitle},
  shorttitle  = {Act of Mar.\ 3, 1801},
  sorttitle   = {1801-03-03},
  url         = {https://www.govinfo.gov/content/pkg/STATUTE-2/pdf/STATUTE-2-Pg115.pdf},
  urldate     = {2026-10-07},
  annotation  = {Title: An Act supplementary to the act intituled An act concerning the District of Columbia. Sec. 1 gives the circuit
                 court, for the county of Alexandria, the powers over
                 constables, inspectors, surveyors, mills, highways and ferries
                 that "have heretofore been vested in the county courts of the
                 commonwealth of Virginia"; sec. 4 makes the magistrates of
                 each county "a board of commissioners within their respective
                 counties" with the powers of "the levy courts or commissioners
                 of county for the state of Maryland", so the county tax was
                 levied by appointed magistrates; sec. 7 lets the sheriff of
                 "Fairfax county in the commonwealth of Virginia" collect
                 within the district the taxes due before December 1800, the
                 act recording that the Virginia part of the district had been
                 Fairfax County. From 1801 to 1847 the county was governed by a
                 federal circuit court and a board of appointed magistrates,
                 not by anyone its residents elected. The copy is the whole
                 act, 2 Stat. 115-117. Read 2026-10-07. Filed in sources as "legal/statutes/federal/United States 1801 - An Act supplementary to the act intituled An act concerning the District of Columbia.pdf", saved as published on 2026-10-07},
}

@online{arlingtonva2011markers,
  author      = {{Arlington County}},
  title       = {The Arlington County Historical Markers (Appendix 1)},
  organization = {Arlington County Historic Preservation Program},
  date        = {2011-08-23},
  url         = {https://www.arlingtonva.us/files/sharedassets/public/v/1/projects/documents/historical-markers-list.pdf},
  urldate     = {2026-10-07},
  annotation  = {The text of every historical marker the County has erected,
                 the Civil War forts since 1965 and other sites the County
                 Board has authorized since 1968, revised 23 August 2011.
                 Marker 49, Necostin Indians, for the Roosevelt Island parking
                 lot, reads: "The Native Americans living in this area when
                 Captain John Smith explored the Potomac in 1608 were an
                 Algonquian-speaking people the English called Nacotchtanks or
                 Necostins. Smith's map shows a village called Nameroughquena
                 (probably "fishing place") in what is now Arlington. Theodore
                 Roosevelt Island was earlier known as "Anacostien Isle," or
                 the Necostins' island. By 1679, the Necostins had moved away
                 due to disease, war, and loss of fishing, hunting, and farming
                 grounds. Traces of earlier cultures have been found throughout
                 Arlington." The notes on the last page record the marker
                 renamed "Native Americans of Arlington" and awaiting agreement
                 with the National Park Service for installation. Marker 21,
                 Little Falls Road, calls the road "originally a trail from the
                 Indian villages at the head of Four Mile Run". This is the
                 County's own usage of the name and the report follows it. The
                 literature also places the Doeg (Tauxenent) on this shore
                 below the Nacotchtank, and some accounts of Arlington name
                 them; the County names only the Nacotchtank, and so does the
                 Park Service (nps2025rooseveltisland). The County has adopted
                 no land acknowledgement that a search of arlingtonva.us on 7
                 October 2026 found. Read 2026-10-07. Filed in sources as
                 "government/local/arlington_county/Arlington County 2011 - The
                 Arlington County Historical Markers (Appendix 1).pdf", saved
                 as published on 2026-10-07; the site refuses an automated
                 request, so the file was fetched by the session's web tool and
                 passed as a copy on 2026-10-07},
}

@online{nps2025rooseveltisland,
  author      = {{National Park Service}},
  title       = {History and Culture: Theodore Roosevelt Island},
  date        = {2025-02-13},
  url         = {https://www.nps.gov/this/learn/historyculture/index.htm},
  urldate     = {2026-10-07},
  annotation  = {The Park Service's page for the island, last updated 13
                 February 2025. It names the people John Smith met on the
                 Potomac in 1608 as "Known variously as Nacotchtank, Anacostan,
                 Nacostine, Anacostine, Anaquashtank, Nacothtant, or
                 Nachatanke", Algonquian-speaking, their English names derived
                 from a word meaning "a town of traders", and says the island
                 came to be called Analostan after them. It does not name the
                 Doeg. Cited as the second witness, beside the County's marker
                 (arlingtonva2011markers), to the name the report uses. Read
                 2026-10-07. Filed in sources as
                 "other/national_park_service/National Park Service 2025 -
                 History and Culture - Theodore Roosevelt Island.pdf", printed
                 from the page on 2026-10-07},
}
