@report{arlingtonboard2023rcv,
  author      = {{Arlington County Board Office}},
  title       = {Establishing Ranked Choice Voting as the Election Method for
                 Arlington County's County Board Primary Elections},
  institution = {Arlington County, Virginia},
  date        = {2023-11-16},
  annotation  = {The staff report for the meeting of 16 December 2023, at which
                 the Board adopted RCV for all County Board primaries. Recounts
                 the engagement history the later reports repeat: a work
                 session with the Electoral Board in October 2021; public input
                 in autumn 2022 drawing more than 780 survey responses, 75 per
                 cent of them favouring implementation, with favourability by
                 zip code lowest in 22207 at 63 per cent and highest in 22203
