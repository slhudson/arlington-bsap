.venv/
__pycache__/
.DS_Store
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
# biblatex/biber and latexmk leave these behind on a local compile. Overleaf
# does its own build, so none of it belongs in the repository.
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.run.xml
.env

# Per-machine Claude Code settings: site permissions and the like, which
# belong to whoever is at the keyboard rather than to the project.
.claude/settings.local.json

# Census scans the build never reads, fetched on demand by
# code/fetch/census_volumes.py and checked against data/contents.csv.
data/raw/us_census_bureau/1880/1880_v1-12.pdf
data/raw/us_census_bureau/1880/1880_v1-13.pdf
data/raw/us_census_bureau/1890/1890a_v1-11.pdf
data/raw/us_census_bureau/1890/1890a_v1-12.pdf
data/raw/us_census_bureau/1890/1890a_v1-13.pdf
data/raw/us_census_bureau/1890/1890a_v1-14.pdf
data/raw/us_census_bureau/1960/09768066v1p48.pdf
data/raw/us_census_bureau/1960/09768066v1p48ch3.pdf
data/raw/us_census_bureau/1970/00496492v1p48.pdf
data/raw/us_census_bureau/1970/00496492v1p48ch03.pdf

# Worktrees the desktop app and subagents make for their own sessions.
.claude/worktrees/

# OCR of the census volumes: a finding aid nothing reads, regenerated by
# code/transcribe/census.py, and 1.8MB of the 7MB of text Overleaf syncs.
data/transcribed/by_ocr/*
!data/transcribed/by_ocr/README.md

# The built layer: reshaped copies of the layers above, rebuilt by bash run.sh
# in seconds, so nothing to review in a diff and 1.6MB kept off the text Overleaf syncs.
data/built/
