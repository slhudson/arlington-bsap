@report{arlingtoncode69oversight,
  author      = {{Arlington County}},
  title       = {Arlington County, Chapter 69 - Law Enforcement Community Oversight Board and Independent Policing Auditor},
  date        = {2026-07},
  url         = {https://www.arlingtonva.us/files/sharedassets/public/county-board/documents/code/ch69_oversightboard.pdf},
  urldate     = {2026-10-03},
  annotation  = {Chapter 69 of the Arlington County Code, 11 pages, as amended by Ord. No. 26-12, adopted 13 June 2026 and effective 1 July 2026. Section 69-11 has the County Board hire the Independent Policing Auditor, who serves at the pleasure of the Board. Read 2026-10-03. Ordinance No. 26-12, adopted 13 June 2026 and effective 1 July, is the history of every section of Chapter 69 but four. Sec. 69-11 now has the County Board hire the Independent Policing Auditor, on merit and at existing pay scales, in an office outside any Police Department facility, serving at the Board's pleasure; sec. 69-12(k) carries the oversight board's delegated powers to the auditor. The Manager keeps three places: he signs the memorandum of understanding with the Police Department (sec. 69-2(c)); records tied to an open matter are withheld until he determines release will not compromise it (sec. 69-8(c)); and where the auditor cannot get a witness or record he decides within four business days whether to require it, may not deny unreasonably, and a denial lets the oversight board by a two-thirds vote seek a subpoena (sec. 69-9). A dispute over the chapter's meaning is the Board's to settle with the County Attorney, finally (sec. 69-13). The text of secs. 69-11 and 69-12 before the amendment, the ordinance's staff report and the auditor's agreement are not held (county-code-board-manager). Filed in sources as "government/local/arlington_county/Arlington County 2026 - Arlington County, Chapter 69 - Law Enforcement Community Oversight Board and Independent Policing Auditor.pdf", the chapter PDF as published, code updated July
                 2026, saved on 3 October 2026 through an automated fetch, the
                 County's site refusing curl on 2026-10-03},
}

@online{vacode1527092,
  author      = {{Commonwealth of Virginia}},
  title       = {Code of Virginia § 15.2-709.2, County Auditor},
  date        = {2015},
  url         = {https://law.lis.virginia.gov/vacode/title15.2/chapter7/section15.2-709.2/},
  urldate     = {2026-10-03},
  annotation  = {The page's history line reads 2015, c. 282. The board may appoint a county auditor, who serves at the pleasure of the board, and whose removal is not subject to review by any other employee, agency, board or commission of the county or to the grievance procedure under § 15.2-1506. Read 2026-10-03. Sec. 15.2-709.2, added in 2015 (c. 282): the board of a county under the plan may appoint a county auditor to audit and review county agencies and county-funded functions, serving at the board's pleasure, a removal not reviewable by any other employee, agency, board or commission of the county or by the grievance procedure. The policing auditor's statute (vaacts2026c372) copies its staffing and pleasure language. Chapter 6 of the County Code does not name the County Auditor. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 2015 - Code of Virginia § 15.2-709.2, County Auditor.pdf", printed from the page on
