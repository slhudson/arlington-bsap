@online{noetzel1907,
  author      = {Noetzel, Gregor and Boteler, G. G.},
  title       = {Map of Alexandria County, Virginia: Formerly Part of the District of Columbia},
  date        = {1907},
  url         = {https://www.loc.gov/item/89692766/},
  urldate     = {2026-10-05},
  annotation  = {Rules a dash-dot boundary line, distinct from roads, railroads
                 and streams, separating the three magisterial districts
                 (Washington, Arlington, Jefferson, each lettered DISTRICT
                 across its area): one line crosses north of Hall's Hill and
                 Glebe Estate between the Washington and Arlington districts,
                 and another crosses Four Mile Run near Nauck between the
                 Arlington and Jefferson districts. The same dash-dot symbol
                 also rules the Town of Falls Church's limits and the
                 county/District of Columbia line, so it reads as this map's
                 general convention for a civil boundary. Published under the
                 authority of the Alexandria County Board of Supervisors (per
                 the Arlington Public Library catalog note) and compiled by
                 Noetzel in 1907, 25 years before the magisterial districts
                 ended. Call number G3883.A8 1907 .N6; also held at the
                 Arlington Public Library Center for Local History (VA/MAP
                 975.5296 R2 NOETZ 1907, donated by the Arlington Historical
                 Society) and reproduced as Figure 1, uncredited for its dash-
                 dot lines, in hjerpe2021. Not yet traced into
                 data/transcribed/; this entry only establishes that the source
                 exists and rules the lines. Read 2026-10-05. Filed in sources as
                 "government/local/alexandria_county/Noetzel, Gregor and Boteler, G. G. 1907 - Map of Alexandria County, Virginia - Formerly Part of the District of Columbia.jpg", downloaded from the Library of Congress's IIIF
                 image service at tile.loc.gov (pct:25, 1738\,x\,2062 px) on 6
                 October 2026; the catalog page itself (www.loc.gov) answered
                 this session with a Cloudflare human-verification check,
                 confirmed instead through the Wayback Machine's 8 March 2026
                 capture of the catalog page (web.archive.org/web/2026030820004
                 9/https://www.loc.gov/resource/g3883a.ct009226/), which lists
                 the image-service download links used here on 2026-10-05},
}

@article{eveningstar19301105b1,
  title       = {Arlington Votes for Manager Rule in County Offices},
  journaltitle  = {Evening Star},
  location    = {Washington, D.C.},
  date        = {1930-11-05},
  pages       = {B-1},
  url         = {https://www.loc.gov/resource/sn83045462/1930-11-05/ed-1/?sp=17},
  urldate     = {2026-10-05},
  annotation  = {Read from the Library of Congress's Chronicling America scan, the page
                 image (the OCR text misreads several figures; page B-1 of the issue).
                 Prints the precinct-by-precinct table "ARLINGTON GOVERNMENT VOTE", whose
                 totals -- 2,067 to 1,031 for a change of government, 1,936 to 428 for the
                 county manager form over the commission form, and 1,689 to 1,149 for
                 election of the board at large over by district -- match Rose 1976
                 exactly on all three questions, settling `at-large-vote-1930`
                 (questions.csv) in Rose's favor. Also reports that the fight over
                 abolishing the magisterial districts for at-large election was opposed by
                 Capt. Crandal Mackey, Clarence R. Ahalt and other members of the county's
                 board of supervisors "on the grounds that it was a severe blow to the
                 Democratic form of government," and names Robert N. Anderson as chairman
                 of the Arlington County Civic Federation's campaign committee. Filed in
                 sources as "press/evening_star/Evening Star 1930 - Arlington Votes for Manager Rule in County Offices.pdf", a copy downloaded in Sally's own browser on 2026-10-06.},
  sortname    = {{Evening Star}},
}

@article{eveningstar19301026b2,
  title       = {Change in County Plan Is Opposed: Opponents of Proposed New Arlington
                 Form Launch Campaign},
  journaltitle  = {Evening Star},
  location    = {Washington, D.C.},
  date        = {1930-10-26},
  pages       = {B-2},
  url         = {https://www.loc.gov/resource/sn83045462/1930-10-26/ed-1/?sp=18},
  urldate     = {2026-10-05},
  annotation  = {Read from the Library of Congress's Chronicling America scan, the page
                 image (Sunday Star, Part One). Datelined Clarendon, 25 October. Robert H.
                 Forman, executive secretary of the Voters' Service Club, opposes the
                 county manager plan on cost grounds, not on at-large election as such.
                 Capt. Crandal Mackey and Clarence R. Ahalt call abolishing the magisterial
                 districts "a direct departure from representative government" that "should
                 not be tolerated", comparing it to electing the House of Delegates and
                 Congress at large. For the change, John A. Petty, president of the
                 Livingstone Heights Civic League, lists "wiping out the magisterial
                 districts, thus making Arlington County a single unit" and "election at
                 large of the county board gives every voter the right to cast his ballot
                 for or against each of the members of the county board" among the plan's
                 advantages. This is the primary-source statement of the at-large-vs-
                 district argument `method-1930-advocacy` (questions.csv) found the Chronicle
                 and the Federation's pamphlet are not held to supply; Anderson 1958 dates
                 Forman's statement to 23 October, but the Star printed it on the 26th, the
                 Sunday before. Filed in sources as "press/evening_star/Evening Star 1930 - Change in County Plan Is Opposed.pdf", a copy downloaded in Sally's own browser on
                 2026-10-06.},
  sortname    = {{Evening Star}},
}

