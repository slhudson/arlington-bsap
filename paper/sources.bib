@jurisdiction{brownvarlington1985,
  title       = {County Board of Arlington County v. Brown},
  note        = {229 Va. 341, 329 S.E.2d 468 (Supreme Court of Virginia, 1985)},
  date        = {1985-04-26},
  url         = {https://www.courtlistener.com/opinion/1158625/county-bd-of-
                 arlington-county-v-brown/},
  urldate     = {2026-09-30},
  annotation  = {Compton, J., for the court; Russell, J., dissenting. Record
                 No. 841641, brought October 1984 and decided 26 April 1985;
                 the County Attorney's report gives 1985 in its list and 1984
                 in its discussion, and the reported opinion settles the
                 decision at 1985. The Board had accepted a letter of intent to
                 let 6.4 acres of the courthouse parking lot to a private
                 developer on a 75-year ground lease for office, hotel, retail
                 and residential use, and directed the County Manager to sign
                 it; he refused, believing the County's authority doubtful, and
                 the Board sought a writ of mandamus to compel its own Manager.
                 Holds, 229 Va. at 345-46, that the parcel is not "unused
                 lands" within Code sec. 15.1-261.1 because it "has a
                 substantive, functional use" as parking, and at 346-47 that
                 sec. 15.1-262's power to "sell ... or exchange and convey"
                 carries no power to lease: "Nowhere in the statute is the
                 power given to counties to grant less than fee simple title to
                 county land", and the general power to lease that sec.
                 15.1-847 gives municipalities "demonstrates a clear
                 legislative intent to withhold from counties any power to
                 lease not otherwise specifically granted." Writ denied; the
                 General Assembly granted the authority afterwards. Applies
                 Dillon's Rule expressly at 344, citing
                 commonwealthvarlington1977. With that case and
                 arlingtonvwhite2000 it is the third of the three Arlington
                 decisions the County Attorney's report lists, and the only one
                 about the County Manager Plan itself: the Board could not
                 compel its own Manager to act. Filed in Drive as "legal/Supreme
                 Court of Virginia 1985 - County Board of Arlington County v.
                 Brown.pdf", the Harvard Caselaw Access Project scan
                 of 229 Va. 341 as CourtListener serves it, saved 30 September
                 2026},
}

