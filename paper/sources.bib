@misc{vaconstitution1902,
  author      = {{Commonwealth of Virginia}},
  title       = {Constitution of Virginia},
  date        = {1902},
  url         = {https://rosetta.virginiamemory.com/delivery/DeliveryManagerServlet?dps_pid=IE2924540},
  urldate     = {2026-09-26},
  note        = {Sec. 111 (one supervisor elected in each magisterial district)
                 and sec. 112 (county and district officers elected on the
                 Tuesday after the first Monday in November, entering office
                 on 1 January next succeeding, for a term of four years)},
  annotation  = {The Library of Virginia holds the enrolled Constitution and
                 Schedule, Record Group 97, signed by John Goode (President)
                 and Joseph Button (Secretary) of the Convention, with no
                 restrictions on use. Schedule sec. 10 governs the first
                 election under the Constitution: county and district officers
                 are elected on the Tuesday after the first Monday in November
                 1903, and "the terms of office of the several officers
                 elected at that or any subsequent election shall begin on the
                 first day of January, next after their election" - the same
                 rule sec. 112 states for every later election, with no
                 exception for this first one. Sec. 10's second paragraph
                 names "supervisors of the several counties" among the
                 offices whose sitting holders "are continued until January
                 the first, nineteen hundred and four", confirming the
                 magisterial supervisors elected that November took their
                 seats on 1 January 1904 and not before (`schedule-1902`).
                 Filed in Drive as "legal/Commonwealth of Virginia 1902 -
                 Constitution of Virginia (scan).pdf", the 155-page enrolled
                 original, and "legal/Commonwealth of Virginia 1902 -
                 Constitution of Virginia (transcription).pdf", Brent
                 Tarter's Library of Virginia transcription of it, which
                 names the official printed edition ("The Constitution of the
                 State of Virginia, Adopted by the Convention of 1901-2",
                 Richmond, 1902) as the same text; both fetched 26 September
                 2026. Supersedes the incomplete hosted PDF fetched 24
                 September 2026, which stopped mid-sentence in Article IX at
                 sec. 136 and carried no Schedule.},
}

% ------------------------------------------- the Board's creation, 1851-1875

@misc{vaconstitution1869,
  author      = {{Commonwealth of Virginia}},
  title       = {Constitution of Virginia},
  date        = {1869},
  url         = {https://archive.org/details/constitutionofvi00virg},
  urldate     = {2026-09-26},
  annotation  = {Sections read: Art. III (Elective Franchise and
                 Qualifications for Office), sec. 1 (a voter's residence:
                 twelve months in the state and three months in "the county,
                 city or town in which he shall offer to vote") and sec. 2
                 ("all persons entitled to vote shall be eligible to any
                 office within the gift of the people, except as restricted
                 in this Constitution"); Art. VII (County Organizations),
                 sec. 1 (county officers elected county-wide) and sec. 2
                 (each county divided into not fewer than three townships,
                 one supervisor elected annually in each, and "The
                 Supervisors of each township shall constitute the Board of
                 Supervisors for that county"). The printed edition framed
                 by the convention that met in Richmond in December 1867:
                 the title page reads "passed April 17, 1868", printed at
                 the Office of the New Nation, 1868. It was ratified by the
                 voters in July 1869 and the first officers under it took
                 office in 1870, so it is dated here by the year it took
                 effect, which is how the report names it. Art. VII sec. 2
                 creates the supervisor and states no residence
                 qualification for him; Art. III sec. 2 makes eligibility
                 for office follow from the vote. The copy held is a four-
                 page extract of the Internet Archive scan of the Library of
                 Congress pamphlet: the title page and printed pages 9, 28
                 and 29, carrying those sections. Nothing else in the
                 document has been read. Two sessions cut excerpts on 26
                 September 2026 and they are combined here.
                 Filed in Drive as "legal/Commonwealth of Virginia 1869 -
                 Constitution of Virginia (title page, Art. III and Art. VII
                 excerpt).pdf"},
}

@misc{vaacts1875,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions Passed by the General Assembly of
                 the State of Virginia During the Session of 1874--5},
  date        = {1875},
  location    = {Richmond},
  url         = {https://archive.org/details/actsandjointres01assegoog},
  urldate     = {2026-09-26},
  annotation  = {Sections read: Ch. 69 sec. 1 (approved 2 February 1875),
                 "township" in any statute passed before 3 November 1874 is
                 to be read as the magisterial districts the amendment
                 directs; ch. 76 sec. 1 (approved 5 February 1875), the
                 townships as they existed "on the third day of November,
                 eighteen hundred and seventy-four, (the date of the
                 ratification of amendment to the constitution respecting
                 county organization)" are "hereby declared to be, the
                 magisterial districts", keeping their boundaries, names and
                 voting places; ch. 158 sec. 4 (approved 8 March 1875), in
                 each magisterial district the qualified voters choose one
                 supervisor, one constable, three justices and one overseer
                 of the poor. INCOMPLETE. Ch. 76 is the act that carried out
                 the constitutional amendment on county organization
                 ratified 3 November 1874; it renames the unit and leaves
                 the officers alone. The amendment itself is not in this
                 volume and has not been read (township-amendment-1874 in
                 docs/questions.csv): both chapters describe it and date its
                 ratification, which is what is cited. Ch. 158 is titled "An
                 act to provide for the Election and Qualification of County
                 Officers" and is the general law under which supervisors
                 were elected from 1875; sec. 4 names the electorate ("the
                 qualified voters of the same"), fixes the term at two
                 years, and states no residence qualification for any of the
                 four district officers it creates. The copy held is a
                 seven-page extract of the Internet Archive scan of the
                 Google-digitized volume: the title page and printed pages
                 52, 56-58, 133 and 134. The scan carries no text layer, so
                 chapter numbers and approval dates were read off the page
                 images. Nothing else in the volume has been read. Two
                 sessions cut excerpts on 26 September 2026 and they are
                 combined here. Filed in Drive as "legal/Commonwealth of
                 Virginia 1875 - Acts and Joint Resolutions, Session of
                 1874-75 (ch. 69, 76 and 158 excerpt).pdf"},
}

