% ------------------------------------------- consulted to settle a question

% Two proceedings, not one. Both are cited by \cite{pratt1995}, who heard the
% testimony; neither opinion has been read here, which is what the annotations
% admit to.
%
% Entered as @misc deliberately. biblatex-chicago in notes mode silently drops
% @jurisdiction, @legal and @legislation - they compile without a warning and
% simply do not appear in the bibliography, which was checked by compiling
% them. A case therefore goes in as @misc with the court, reporter and docket
% in `note`, which prints, and that is where a reader needs them anyway.

@misc{vollin1974,
  title       = {George Vollin, Jr., et al. v. Mills E. Godwin, et al.},
  note        = {U.S. District Court, Eastern District of Virginia, Alexandria
                 Division, Civil Action No. 173-74-A},
  date        = {1974},
  annotation  = {A civil rights suit to have Arlington's at-large voting system
                 declared unconstitutional. Vollin testified in 1974; the eight
                 plaintiffs are named in pratt1995 note 16. Court, division and
                 docket number as pratt1995 notes 5 and 15 print them. The
                 filing date, the outcome and the opinion have not been read
                 here, and no year but the testimony's is recorded},
}

@misc{vollinelectoralboard,
  title       = {George Vollin, Jr., et al. v. Arlington County Electoral Board
                 and Cornelia B. Rose},
  note        = {216 Va. 674, 222 S.E.2d 793 (Supreme Court of Virginia, 1976)},
  date        = {1976-03-05},
  annotation  = {Decided 5 March 1976, Record No. 741174, opinion by Harrison,
                 J.; read from the reported opinion. Pratt cites it at 216 Va.
                 674 and his scan prints it "Yollin", a misread V. **A
                 different action from vollin1974**: more than two hundred
                 Arlington voters petitioned under Code s 15.1-694 to put the
                 question of district rather than at-large election to the
                 voters, and the petition was denied because the county had
                 already adopted the County Manager Plan. The report should not
                 merge the two. Note the respondent Cornelia B. Rose - see the
                 annotation to rose1964},
}

