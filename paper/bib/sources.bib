@article{dailysun1952petitions,
  title       = {Petition Seeks to Incorporate County as City},
  journaltitle = {Daily Sun},
  location    = {Arlington, Va.},
  date        = {1952-07-19},
  pages       = {1},
  url         = {https://virginiachronicle.com/?a=d&d=TDS19520719.1.1},
  urldate     = {2026-10-01},
  annotation  = {The two petitions filed under vaacts1952c49, and the page that
                 sets the 4 November 1952 ballot. The incorporation petition
                 "was filed Primary Day in Arlington Circuit Court by Mrs. Vera
                 Dean, wife of Non-Partisan County Board Alan L. Dean", and if
                 enough signatures stand "Circuit Judge William D. Medley must
                 accede by Aug. 1" - though the same story later says "Circuit
                 Judge Walter T. McCarthy will be required to call for a
                 referendum by Aug. 1", so the page names two judges for the
                 same duty. Incorporation would also put two further questions:
                 "(1) Shall the City Council consist of five or seven members?
                 There presently are five seats on the County Board. (2) Shall
                 the city school board be appointed by the City Council or
                 elected by the people? Arlington is the only Virginia county
                 that has an elected school board." That is the only route by
                 which a five-or-seven question reached Arlington voters in
                 1952; the one vaacts1952c591 offered was never petitioned for.
                 The second petition, "signed by 204 voters", was "filed July
                 11 by Mrs. George C. Vietheer, prsident of the Arlington
                 League of Women Voters", carrying "(1) Shall the County
                 Manager be appointed for an indefinite term, subject to
                 removal at any time by the County Board? (2) Shall the heads
                 of the County departments be appointed by the Countv Manager?"
                 - the two questions vaacts1952c198 prints. The paper adds the
                 background: "This referendum apparently steii: * f. mn a
                 dispute between County political factions last year over
                 whether the County Manager has the power to appoint department
                 heads. The Arlington Circuit Court ruled that the County Board
                 should make the appointments", which runs the other way from
                 dailysun1951policechief; and "The county Manager presently
                 serves for one year and is eligible for additional consecutive
                 terms." Incorporation's purpose is given plainly: federal
                 employees had been barred from Board seats by Judge McCarthy,
                 the appeal was pending with a decision expected in September,
                 and "Legal authorities maintain that this ban does not apply
                 in Virginia cities". Filed in sources as "press/arlington_daily_sun/Daily Sun 1952 - Petition Seeks To Incorporate County As City (19 July 1952, p. 1).pdf", the page text as Virginia Chronicle
                 serves it at f=XML, set out on a plain page by
                 code/sources/pages.py and printed on 1 October 2026; the site
                 refuses an automated request and its page images are behind a
                 login, so no copy of the image was had, and the OCR is poor
                 enough in places that it is quoted here as it stands.},
  sortname    = {{Daily Sun}},
}

@article{dailysun1952ruling,
  title       = {Fate Of 3 County Board Seats Was Hanging In Balance Since
                 Judge McCarthy's May 5 Ruling (10 September 1952, pp. 1 and 5)},
  journaltitle = {Daily Sun},
  location    = {Arlington, Va.},
  date        = {1952-09-10},
  pages       = {1, 5},
  url         = {https://virginiachronicle.com/?a=d&d=TDS19520910.1.1},
  urldate     = {2026-10-01},
  annotation  = {The day the Supreme Court of Appeals decided paolicelli1952,
                 with the litigation set out from the start. The suit was
                 "brought by John Locke Green on behalf of six citizens
                 challenging the right of one of the members to his seat since
                 he was a Federal worker", pointed "specifically to Alan L.
                 Dean, a Bureau of the Budget officer", and charged that he
                 held office "in violation of a 1788 Virginia statute, Section
                 2-27, of the State Code". Judge Walter T. McCarthy upheld it
                 on "May 5" - the paper gives that date twice, where the
                 opinion affirms a circuit decree of 8 May and names no judge -
                 holding the Arlington exemption unconstitutional because it
                 applied to counties over 300 inhabitants a square mile: "There
                 is no reasonable relationship between the density of
                 popula[tion]". Cox: "I am. of course, disappointed that I will
                 not be able to finish the term for which the people of
                 Arlington elected me." Dean: "I am naturally disappointed...
                 it enabled a group of local irreconcilables in the real estate
                 and building industry to drive from the board, people elected
                 in fair" election. The jump on p. 5 carries the contempt
                 citations: Robert W. Cox, "chairman of the board who may also
                 be affected by the decision since he is an employe also of the
                 Federal Communications Commission", was cited for a 21 May
                 speech to the Fairlington Civic Association saying it was
                 "perfectly ridiculous that more than half of the county is
                 barred from holding office", and the Rev. Ross Allen Weston,
                 of the Arlington Unitarian Church, for a sermon in which "he
                 was forced to the conclusion that Judge McCarthy's decision
                 coincides with the interests of the Byrd organization"; Cox's
                 charge was dropped and Weston's was pending, with a decision
                 expected that Friday. It also records that the High Court
                 agreed to hear the case "In an unprecedented move... a case it
                 had not agreed to review", heard argument on 10 June and held
                 it to the fall term; and that on 4 September a federal court
                 in Alexandria, Judge Albert V. Bryan, dissolved a twenty-day
                 restraining order barring Cox and Dean from discussing rent
                 control, holding the federal statute inapplicable because "it
                 dealt only with persons holding more than one Federal job".
                 Page 1 also reports the three candidates for the regular seat
                 - Ivan A. Booker, Non-Partisan; Wesley W. Cooper, Democrat;
                 George M. Rowzee, Jr., Republican - and that Alfred E. Frisbie
                 was not seeking re-election. Filed in sources as "press/arlington_daily_sun/Daily Sun 1952 - Fate Of 3 County Board Seats Was Hanging In Balance Since Judge McCarthy's May 5 Ruling (10 September 1952, pp. 1 and 5).pdf", the page text as Virginia Chronicle
                 serves it at f=XML, set out on a plain page by
                 code/sources/pages.py and printed on 1 October 2026; the site
                 refuses an automated request and its page images are behind a
                 login, so no copy of the image was had, and the OCR is poor
                 enough in places that it is quoted here as it stands.},
  sortname    = {{Daily Sun}},
}

@article{dailysun1952lwv,
  title       = {LWV States Stand On Questions: Women Voters Withhold Decision
                 On Incorporation (27 October 1952, pp. 1-2)},
  journaltitle = {Daily Sun},
  location    = {Arlington, Va.},
  date        = {1952-10-27},
  pages       = {1-2},
  url         = {https://virginiachronicle.com/?a=d&d=TDS19521027.1.1},
  urldate     = {2026-10-01},
  annotation  = {The whole 1952 ballot, question by question, and the case made
                 for the strong-manager form. The Arlington League of Women
                 Voters "defined its position on the seven questions to be
                 voted on in the Nov. 4 election". On incorporation: "Questions
                 3, 4 and 5 concern the incorporation of Arlington as a city
                 under the 1946 charter", studied for over a year and at nine
                 unit meetings, but "the League members decided to make no
                 recommendation for or against incorporation at this time". On
                 the rest the League "voted overwhelmingly to urge public
                 support of the two referendums to the County Manager Act and
                 also of the referendum providing for a real estate assessment
                 department", having concluded after two years' study that the
                 first two "would greatly increase the responsiveness of the
                 county manager to the will of the people of the county". Its
                 reasoning is an accountability argument, not an insulation
                 one: "the county manager is the employee of the county board
                 and should answer directly to the board for properly carrying
                 out its policies. Though it seems this makes the manager's
                 tenure uncertain, it should be pointed out that the
                 professional association of city and county managers prefers
                 this practice"; and on question 2, "if the county manager is
                 to be completely responsible to the county board, he must also
                 have the right and the duty to appoint department heads". The
                 continuation on p. 2 accounts for the last two: the League
                 "urges everyone to vote 'Yes' on Questions 1, 2 and 7", and
                 question 6 is a statewide constitutional amendment permitting
                 appropriations to institutions of learning in other states, on
                 which the state League took no position while explaining that
                 it would let Virginia join the Southern Regional Education
                 Council and was "aimed especially at. providing more
                 educational opportunities for Negroes without breaking down
                 segregation barriers". So the seven are: 1 and 2 the County
                 Manager Act (vaacts1952c198), 3 to 5 incorporation, 6 the
                 state amendment, 7 real estate assessments
                 (vaacts1952c610c611). Neither the county attorney questions of
                 vaacts1952c569 nor the board questions of vaacts1952c591 is
                 among them. Filed in sources as "press/arlington_daily_sun/Daily Sun 1952 - LWV States Stand On Questions - Women Voters Withhold Decision On Incorporation (27 October 1952, pp. 1-2).pdf", the
                 page text as Virginia Chronicle serves it at f=XML, set out on
