@article{dailysun1951spicer,
  title       = {Spicer Suggests, in New Book, Changes in Arlington County Governmental Relationships},
  journaltitle = {Daily Sun},
  location    = {Arlington, Va.},
  date        = {1951-12-17},
  pages       = {5},
  url         = {https://virginiachronicle.com/?a=d&d=TDS19511217.1.5},
  urldate     = {2026-10-02},
  annotation  = {What the Board's January 1951 action had left by the winter
                 before the 1952 session. "On January 27, 1951, the board took
                 over from the county manager the power to appoint department
                 heads, and this action was upheld by Judge Walter T. McCarthy
                 in an Arlington Circuit Court test." The Board's Advisory
                 Committee on Government Organization and Procedure and the
                 Arlington Civic Federation "have recommended introduction of
                 legislation that would give back to the county manager the
                 power to appoint department heads, but that would make the
                 county manager's tenure at office indefinite", and the
                 delegation, Senator Charles R. Fenwick and Delegates J.
                 Maynard Magruder and George Damm, "have not endorsed the
                 recommended changes, but plan to introduce bills that would
                 provide referenda on the changes." George W. Spicer's new book
                 is quoted as finding the arrangement unworkable, since "The
                 manager can exercise no effective control over department
                 heads without some voice in their selection and removal", and
                 as granting "some plausibility in the position of the board,
                 since the manager is not subject to removal at their pleasure".
                 Nothing in the article mentions a bar on members' taking part
                 in appointments. Only the article is filed, not the page; an
                 advertisement and a column break run through it on the page
                 and are left out. Filed in sources as "press/arlington_daily_sun/Daily Sun 1951 - Spicer Suggests, In New Book, Changes In Arlington County Governmental Relationships (17 December 1951, p. 5).pdf", the article's text as Virginia Chronicle serves it at
                 f=XML, set out on a plain page by code/sources/pages.py with
                 plain OCR slips corrected and printed on 2 October 2026; the
                 site refuses an automated request and its page images are
                 behind a login, so no copy of the image was had.},
  sortname    = {{Daily Sun}},
}

