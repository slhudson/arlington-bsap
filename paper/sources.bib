@jurisdiction{commonwealthvarlington1977,
  title       = {Commonwealth of Virginia v. County Board of Arlington County},
  note        = {217 Va. 558, 232 S.E.2d 30 (Supreme Court of Virginia, 1977)},
  date        = {1977-01-14},
  url         = {https://www.courtlistener.com/opinion/1277629/commonwealth-v-county-board-of-arlington-county/},
  urldate     = {2026-09-26},
  annotation  = {Carrico, J., for a unanimous court. Frames the question, 217
                 Va. at 573, as "one of first impression for this court"
                 for "local governing bodies in Virginia" generally, not
                 Arlington's alone, which is why the ruling reached
                 public-sector bargaining statewide; the General Assembly did
                 not restore local authority to bargain until 2021. Holds, 217
                 Va. at 581: "to the extent the boards' policies permit
                 collective bargaining and collective bargaining agreements
                 with recognized labor organizations, the policies are
                 declared invalid... the agreements are declared void."
                 Filed in Drive as "legal/Supreme Court of Virginia 1977 -
                 Commonwealth v. County Board of Arlington County.pdf"},
}

@jurisdiction{arlingtonvwhite2000,
  title       = {Arlington County v. White},
  note        = {259 Va. 708, 528 S.E.2d 706 (Supreme Court of Virginia, 2000)},
  date        = {2000-04-21},
  url         = {https://www.courtlistener.com/opinion/1059632/arlington-county-v-white/},
  urldate     = {2026-09-26},
  annotation  = {Koontz, J., for the majority; Kinser, J., concurring; Hassell,
                 J., joined by Carrico, C.J., and Compton, S.J., concurring in
                 the judgment on other grounds. The County had extended its
                 self-funded health plan to employees' "domestic partners".
                 Holds, 259 Va. at 714: the County's "expanded definition of
                 dependents eligible to receive coverage under the self-funded
                 health insurance benefits plan ... is not a reasonable
                 method of implementing its implied authority under those
                 statutes and is, therefore, an ultra vires act." With
                 commonwealthvarlington1977 it is one of the two Arlington
                 cases that carry Virginia's Dillon's Rule doctrine. Filed in Drive as
                 "legal/Supreme Court of Virginia 2000 - Arlington County v.
                 White.pdf"},
}

