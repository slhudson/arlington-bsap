@jurisdiction{bennettvgarrett1922,
  title       = {Bennett v. Garrett},
  note        = {132 Va. 397, 112 S.E. 772 (Supreme Court of Appeals of
                 Virginia, 1922)},
  date        = {1922-06-15},
  url         = {https://www.courtlistener.com/opinion/6919203/bennett-v-
                 garrett/},
  urldate     = {2026-09-30},
  annotation  = {Kelly, P., for the court; affirmed. Inhabitants of Clarendon
                 petitioned the Circuit Court of Arlington County for a town
                 charter under ch. 116 of the Code of 1919; the board of
                 supervisors and several hundred county residents opposed it,
                 and the court dismissed the petition. Holds, 132 Va. at 406,
                 that where proposed corporate limits are "carved out of a
                 thickly settled section" the "general good of the community"
                 the statute requires "must be construed as embracing the whole
                 section", following Board of Supervisors of Norfolk County v.
                 Duke, 113 Va. 94. At 407: Clarendon and Ballston are
                 "practically interlocked", about a mile apart, and "it appears
                 doubtful whether any small town could be chartered therein
                 without detriment to the general good of the county" - the
                 passage samuel2026 note 7 reads as the inference that no town
                 may incorporate within Arlington. The court did not call
                 Arlington "a continuous, contiguous, and homogeneous
                 community": neither "homogeneous" nor "homogenous" nor
                 "contiguous" occurs anywhere in the opinion, and its own words
                 are "a part only of a thickly settled community". The
                 attribution is rose1976 p. 176, which puts the phrase in
                 quotation marks in the court's mouth and cites nothing for it;
                 she reuses it at p. 197 of the 1932 change and at p. 229 of
                 1976. bestebreurtje2017 quotes her p. 197 sentence, and her
                 own account of this case, at p. 14 n. 25, is accurate and
                 free of the phrase. Filed in Drive as "legal/Supreme
                 Court of Appeals of Virginia 1922 - Bennett v. Garrett.pdf",
                 the Harvard Caselaw Access Project scan of 132 Va. 397 as
                 CourtListener serves it, saved 30 September 2026},
}

@legislation{waltonact1894,
  author      = {{Commonwealth of Virginia}},
  title       = {An Act to Provide for the Method of Voting by Ballot},
  note        = {Acts and Joint Resolutions Passed by the General Assembly of
                 the State of Virginia During the Session of 1893--94, ch. 746,
                 approved 6 March 1894; the Walton Act},
  date        = {1894-03-06},
  url         = {https://www2.vcdh.virginia.edu/afam/politics/legislation.html},
  urldate     = {2026-09-30},
  annotation  = {Sections the report uses: sec. 3, the official "white paper
                 ticket" carries every candidate who has complied with the act
                 and "None other shall be a legal ballot"; sec. 11, the elector
                 must "draw a line with a pen or pencil through the names of
                 the candidates he does not wish to vote for", no name counts
                 as scratched "unless the pen or pencil mark extend through
                 three-fourths of the length of said name", and an office for
                 which more than one name survives is void; sec. 15, the
                 electoral board of each county or city appoints for each
                 precinct one special constable, who must be "able to read and
                 write" and who alone may read the ballot to and mark it for an
                 elector "physically or educationally unable to vote" - the
                 appointment is the electoral board's, not a judge's; sec. 16,
                 any board member, printer, judge of election "or any other
                 person" who gives or sells any official ballot "or any copy,
                 or any fac-simile of the same, or any information about the
                 same" is guilty of a misdemeanor. The filed copy carries the
                 whole act, nineteen sections, including the candidate notice,
                 the screened booth and a two-and-a-half- minute limit in it.
                 That copy is the Virginia Center for Digital History's
                 transcription of ch. 746, printed from its page on 30
                 September 2026; the printed session-acts volume for 1893-94 is
                 on neither Internet Archive nor HathiTrust and has not been
                 read, so the chapter number and the approval date rest on the
                 transcription (waltonact-session-acts). Filed in Drive as
                 "legal/Commonwealth of Virginia 1894 - An Act to Provide for
                 the Method of Voting by Ballot (transcription).pdf"},
}

@book{rose1976,
  author      = {Rose, Cornelia B., Jr.},
  title       = {Arlington County, Virginia: A History},
  publisher   = {Arlington Historical Society},
  location    = {Arlington},
  date        = {1976},
  url         = {https://archive.org/details/arlingtoncountyv0000rose},
  urldate     = {2026-09-30},
  annotation  = {This is where "continuous, contiguous, and homogeneous
                 community" comes from, and Rose gives no source for it. At p.
                 176, on Bennett v. Garrett: "The case was eventually decided
                 by the Supreme Court of Appeals of Virginia which held that
                 Arlington County was a 'continuous, contiguous, and
                 homogeneous community' that could not be subdivided for the
                 purposes of incorporating a portion of it." None of the three
                 words occurs anywhere in the opinion, the page's only footnote
                 is to Acts of Assembly 1920 ch. 241 for the county's renaming,
                 and the quotation marks are Rose's own; see
                 bennettvgarrett1922. At p. 197 she reuses the phrase for the
                 change the Board made in 1932: "the fact that the Magisterial
                 Districts had been abolished and the County Board elected at
                 large, meant a governing body more responsive to the needs of
                 the whole County rather than pitting one section against
                 another. The 'Continuous, contiguous, and homogeneous' nature
                 of Arlington had now found expression in its form of
                 government." At p. 229 she uses it a third time, of 1976:
                 Arlington is "much more 'continuous [and] contiguous' than
                 fifty years ago, but far less 'homogeneous'." Her spelling
                 throughout is homogeneous. bestebreurtje2017 note 552 prints
                 homogenous and cites p. 167, where this printing carries a
                 passage on rail lines and air travel; Arlington's own County
                 Manager Plan page quotes the p. 197 sentence and spells it
                 homogeneous. Pages read: the title page, 176 and 197, from the
                 Internet Archive's borrowable scan on 30 September 2026;
                 nothing else in the book has been read, and the chapters on
                 the 1930 referendum and the 1958-59 Commission on
                 Incorporation are still to read. Filed in Drive as "books/Rose
                 1976 - Arlington County, Virginia- A History (title page and
                 pp. 176, 197 excerpt).pdf", page images captured from the
                 borrowed scan in Sally's own browser},
}
