@legislation{vaacts1847,
  author      = {{Commonwealth of Virginia}},
  title       = {An act to extend the jurisdiction of the commonwealth of
                 Virginia over the county of Alexandria},
  organization = {General Assembly of Virginia, session of 1846-47},
  date        = {1847-03-13},
  url         = {https://www.google.com/books/edition/_/jQlAAAAAYAAJ?gbpv=1&pg=PA41},
  urldate     = {2026-09-27},
  note        = {Ch. 53 of the Acts of the General Assembly passed at the
                 session commencing 7 December 1846 and ending 23 March 1847,
                 pp. 41-42, passed 13 March 1847. Sec. 1 declares the territory
                 of Alexandria county, retroceded by the act of Congress of 9
                 July 1846 and accepted by Virginia, to be an integral portion
                 of the commonwealth, its citizens entitled to the rights of
                 the constitution and bill of rights. Sec. 2 makes the public
                 and general laws of Virginia, and the common law, the law of
                 the territory from 20 March 1847. Secs. 3-8 (not transcribed
                 here) form the new county of Alexandria, fix its courthouse,
                 representation and judicial circuit, and provide for its
                 courts and officers.},
  annotation  = {Read 2026-09-27. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 1847 - Acts of the General Assembly of Virginia.pdf",
                 a copy printed in Sally's own browser on 2026-09-27},
}

@legislation{vaacts1873amendment,
  author      = {{Commonwealth of Virginia}},
  title       = {Joint Resolutions Proposing Amendments to Article VII of the Constitution, in Relation to County Organization},
  organization = {General Assembly of Virginia, session of 1872-73},
  date        = {1873-03-31},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280167d&seq=278},
  urldate     = {2026-09-27},
  note        = {Ch. 301, agreed to 31 March 1873, pp. 274-277. Proposes
                 striking secs. 1-4 of art. VII (county organization, including
                 sec. 2 dividing counties into townships) and inserting new
                 secs. 1-4, sec. 2 of which divides counties into magisterial
                 districts (not townships) with one supervisor, three justices,
                 one constable and one overseer of the poor in each. The
                 schedule (clauses 2-4) has existing township officers continue
                 until replaced and directs publication and certification to
                 the next general assembly for its concurrence, per art. XII of
                 the 1869 constitution's amendment procedure; this is the first
                 of the two required passages, referred to the next General
                 Assembly for agreement, and the amendment was ratified by the
                 people 3 November 1874 per vaacts1875.},
  annotation  = {Read 2026-09-27. The amendment to art. VII respecting county organization, agreed to 31 March 1873 (ch. 301 of the 1872-73 session) and ratified by the people on 3 November 1874, strikes the section dividing counties into townships and inserts one dividing them into magisterial districts, each electing one supervisor, three justices, one constable and one overseer of the poor. vaacts1875 then declares the existing townships to be those districts, so the conversion renamed units Alexandria County already had. Filed in sources as "legal/statutes/state/Commonwealth of Virginia 1873 - Joint Resolutions Proposing Amendments to Article VII of the Constitution, in Relation to County Organization.pdf", a copy printed in Sally's own browser on
                 2026-09-27},
}

