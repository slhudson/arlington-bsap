  title       = {Analysis of County Commission Elections in Yakima County, WA},
  date        = {2020},
  url         = {https://democracy.datascience.uchicago.edu/publications/Yakima.pdf},
  urldate     = {2026-10-07},
  annotation  = {Yakima County's three commission districts include two with a
                 Hispanic or Native majority or near-majority, but the
                 commissioner is chosen by a countywide general election, which
                 the report finds negates the districting (p. 1); the report
                 finds county-wide ranked choice likely a more effective remedy
                 than majority-minority districts (p. 1, p. 6). Dated January
                 2020 on the page. Read 2026-10-07. Filed in sources
                 as "academic/data_and_democracy_lab/MGGG Redistricting Lab 2020 - Analysis of County Commission Elections in Yakima County, WA.pdf", saved as
                 published on 2026-10-07},
}

