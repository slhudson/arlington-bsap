@report{tudor2023proportional,
  author      = {Tudor, Grant and Tremitiere, Beau},
  title       = {Towards Proportional Representation for the U.S. House: Amending the Uniform Congressional District Act},
  institution = {Protect Democracy and Unite America},
  date        = {2023-03},
  url         = {https://protectdemocracy.org/wp-content/uploads/2023/03/Towards-Proportional-Representation-_-March-2023-.pdf},
  urldate     = {2026-10-04},
  annotation  = {72 pages. The report argues for amending the Uniform
                 Congressional District Act to allow proportional multi-member
                 House elections. The report is cited for its section
                 "Suppressing Minority Representation Through the Bloc Vote",
                 which starts on p. 22 and ends on p. 23; p. 24 begins the next
                 subsection. It says bloc voting typically produces
                 non-proportional results, so that in a ten-seat district 51
                 per cent of voters can elect all ten seats; that there is
                 little evidence bloc voting first spread in the United States
                 to dilute minority votes; that in the Progressive Era its
                 spread in the South and the North "could be tied more closely
                 to an intent to suppress minority representation"; and that
                 after the Voting Rights Act of 1965 southern white majorities
                 imposed it to minimize minority representation. On p. 23 it
                 gives the half-the-chance finding, "blacks living in cities
                 with at-large elections have half the chance of electing a
                 member [of choice] as blacks in cities using wards", as a 1979
                 study, its note 76 naming Berry and Dye (Florida State
                 University Law Review 7 (1979), not entered here because its
                 PDF could not be fetched) at 85 to 122, and reports that 64
                 per cent of American city council elections used bloc voting
                 as of 2012. The phrases about a "better class" of council
                 members and about "de facto aiming at reducing the influence
                 of immigrants and (the very few) black voters" are quoted
                 there from Engstrom and McDonald (1986) and Trebbi et al.
                 (2008), notes 74 and 75, not the authors' own words. Protect
                 Democracy and Unite America are advocacy organisations. Pages
                 are the report's printed page numbers. Read 2026-10-04. Filed
                 in sources as "other/protect_democracy/Tudor and Tremitiere 2023 - Towards Proportional Representation for the U.S. House - Amending the Uniform Congressional District Act.pdf", saved as published on
                 2026-10-04},
}

@report{orourke1979atlarge,
  author      = {O'Rourke, Timothy G.},
  title       = {City and County At-Large Elections and the Problem of Minority Representation},
  institution = {Institute of Government, University of Virginia},
  date        = {1979-02},
  url         = {https://www.rankedchoiceva.org/files/uva-790201},
  urldate     = {2026-10-04},
  note        = {University of Virginia Newsletter 55, no. 6},
  annotation  = {Four pages, an issue of the University of Virginia Newsletter,
                 published by the Institute of Government, February 1979, by
                 Timothy G. O'Rourke, a research associate on the Institute's
                 staff; the issue number is printed 5 with the 5 struck through
                 and a 6 written in by hand. The scan is of poor quality in
                 places and the OCR text misreads some words. Says that in many
                 cities in the early 1900s "upper-class, business-led reformers
                 regarded at-large elections as a device to reduce the
                 influence of working class and ethnic neighborhoods that found
                 expression through ward based elections", the sentence
                 rcva2025wardstowinner quotes, after giving the reformers'
                 public case against ward provincialism; reports Karnig's ratio
                 of Black council seats to Black population in 139 cities, .772
                 for ward cities, .546 for mixed and .457 for at-large; and
                 tabulates 1977 Black council representation in Virginia's
                 twenty-two cities with nonwhite population above 15 per cent
                 in 1975 (Table 1; Charlottesville 1 of 5 seats, index 1.170),
                 the at-large cities averaging .524 and the ward and mixed
                 cities .713. Says Justice Department action under the Voting
                 Rights Act led Richmond and Petersburg to ward elections and
                 Lynchburg to a mixed ward and at-large plan, and concludes
                 that Virginia cities were unlikely to face a rash of dilution
                 suits. It does not say Black voters have half the chance in
                 at-large cities; that figure is Berry and Dye's. Read
                 2026-10-04. Filed in sources as "academic/university_of_virginia/O'Rourke 1979 - City and County At-Large Elections and the Problem of Minority Representation.pdf", the four article pages of a scan of the
                 newsletter issue hosted by Ranked Choice Virginia at the url
                 above, with the interlibrary-loan slip that heads the scan
                 left out on 2026-10-04},
}

@online{fairvoteblockvsrcv,
  author      = {{FairVote}},
  title       = {Plurality block voting vs. proportional ranked choice voting},
  organization = {FairVote},
  url         = {https://fairvote.org/plurality-block-voting-vs-proportional-ranked-choice-voting/},
  urldate     = {2026-10-04},
  annotation  = {An explainer by an advocacy organisation. The page shows no
                 individual author and no date, so the entry has no date field;
                 the page's HTML metadata gives 24 April 2025 as first
                 published and 2 September 2026 as last modified, and the 2025
                 in the filed copy's name is the first. Defines plurality block
                 voting as each voter voting for as many candidates as there
                 are seats, so that the largest group can choose all the
                 winners, and sets it against proportional ranked choice voting
                 in a comparison table. Gives examples without dates or sources
                 on the page: Lynchburg, roughly 53 per cent Republican voters
                 winning every at-large seat; Harrisonburg, roughly 59 per cent
                 Democratic voters winning every at-large seat; Georgia's
                 five-member Public Service Commission with one Black member in
                 145 years. Says proportional ranked choice voting has been
                 used as a remedy under the federal Voting Rights Act and, with
                 single-member districts as the usual remedy, works where
                 minority voters are not in compact neighborhoods. Linked from
                 rcva2025blockvoting and rcva2025fairrepresentation. Read
                 2026-10-04. Filed in sources as "other/fairvote/FairVote 2025 - Plurality block voting vs. proportional ranked choice voting.pdf", a print of the page's HTML with its scripts
                 removed, which the site's own print stylesheet cuts to the
                 article, made on 2026-10-04},
}

