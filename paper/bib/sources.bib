@legislation{vaconstitution1869,
  title       = {Va.\ Const.\ of 1869},
  date        = {1869},
  url         = {https://archive.org/details/constitutionofvi00virg},
  urldate     = {2026-09-26},
  organization = {Commonwealth of Virginia},
  entrysubtype = {constitution},
  pagination  = {section},
  bookpagination = {section},
  keywords    = {datedintitle},
  sorttitle   = {1869},
  annotation  = {Sections read: Art. III (Elective Franchise and
                 Qualifications for Office), sec. 1 (a voter's residence:
                 twelve months in the state and three months in "the county,
                 city or town in which he shall offer to vote") and sec. 2
                 ("all persons entitled to vote shall be eligible to any
                 office within the gift of the people, except as restricted
                 in this Constitution"); Art. VII (County Organizations),
                 sec. 1 (county officers elected county-wide) and sec. 2
                 (each county divided into not fewer than three townships,
                 one supervisor elected annually in each, and "The
                 Supervisors of each township shall constitute the Board of
                 Supervisors for that county"). The printed edition framed
                 by the convention that met in Richmond in December 1867:
                 the title page reads "passed April 17, 1868", printed at
                 the Office of the New Nation, 1868. It was ratified by the
                 voters in July 1869 and the first officers under it took
                 office in 1870, so it is dated here by the year it took
                 effect, which is how the report names it. Art. VII sec. 2
                 creates the supervisor and states no residence
                 qualification for him; Art. III sec. 2 makes eligibility
                 for office follow from the vote. The copy held is a four-
                 page extract of the Internet Archive scan of the Library of
                 Congress pamphlet: the title page and printed pages 9, 28
                 and 29, carrying those sections. Nothing else in the
                 document has been read. Two sessions cut excerpts on 26
                 September 2026 and they are combined here.
                 Filed in sources as "legal/constitutions/Commonwealth of Virginia 1869 - Constitution of Virginia (title page, Art. III and Art. VII excerpt).pdf"},
}

