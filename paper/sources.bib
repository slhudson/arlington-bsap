@jurisdiction{paolicelli1952,
  title       = {Dean v. Paolicelli},
  note        = {194 Va. 219, 72 S.E.2d 506 (Supreme Court of Virginia, 1952)},
  date        = {1952-09-10},
  url         = {https://www.courtlistener.com/opinion/1365051/dean-v-
                 paolicelli/},
  urldate     = {2026-10-01},
  annotation  = {Miller, J., delivered the opinion; present Hudgins, C.J.,
                 Eggleston, Spratley, Buchanan, Miller and Whittle, JJ. Record
                 No. 4021 1/2. A bill in equity by Rocco Paolicelli and others,
                 citizens and taxpayers of Arlington county, against Alan L.
                 Dean, a member of the County Board, and Colin C. MacPherson,
                 the county treasurer; the Board intervened as a defendant, and
                 Edmund D. Campbell was of counsel for Dean and the Board.
                 Holds sec. 2-27, Code 1950, constitutional: acceptance of
                 federal office or employment, or of "any emolument whatever
                 under such government, shall, ipso facto, vacate any office"
                 held under Virginia or any county, city or town in it. Const.
                 sec. 32, which makes every qualified voter eligible to office,
                 governs eligibility to be elected, and sec. 56 the General
                 Assembly's power to declare an office vacant, so "Sections 32
                 and 56 of the Constitution do not conflict. Their areas of
                 efficacy border but do not overlap." The statute's object is
                 to require "strict and undivided allegiance to the duties and
                 obligations of a public office". Sec. 2-29(11), which exempted
                 federal employees holding county office in a county of more
                 than three hundred inhabitants per square mile, is struck as
                 the special legislation Const. sec. 64 forbids; the circuit
                 court had called it "special and local legislation, and as
                 such, in violation of the constitution of this state" and that
                 much is affirmed. Dean was a federal employee when he took his
                 seat on 1 January 1952, so though legally elected he "never
                 became a de jure officer" - his incumbency, the court says,
                 died a-borning. The circuit court's decree of 8 May 1952 is
                 affirmed and supplemented: the office is declared vacant as of
                 1 January 1952 and the treasurer restrained from paying salary
                 for service after the decree entered here on 10 September
                 1952. The opinion does not name the circuit judge. The ipso
                 facto clause entered the law by Acts of 1883-84, ch. 145, p.
                 181, approved 22 February 1884, which is the provision
                 arlhist1967officials has the county court apply to Perkins W.
                 Squier, Postmaster of Alexandria, in 1884: the same statute
                 reaches the Board at both ends of the period the report
                 covers. Filed in Drive as "legal/state courts/Supreme Court of
                 Virginia 1952 - Dean v. Paolicelli.pdf", the Harvard Caselaw
                 Access Project scan of 194 Va. 219 as static.case.law serves
                 it, saved 1 October 2026; its text layer reads every "h" as
                 "b" on printed pp. 239-240, which were read by eye},
}

@book{nml1916modelcharter,
  author      = {{National Municipal League}},
  title       = {A Model City Charter and Municipal Home Rule},
  publisher   = {{National Municipal League}},
  location    = {Philadelphia},
  date        = {1916-03-15},
  url         = {https://archive.org/download/modelcitycharter00nati/modelcityc
                 harter00nati_djvu.txt},
  urldate     = {2026-10-01},
  annotation  = {Final edition, prepared by the Committee on Municipal Program,
                 dated 15 March 1916. Art. II (the council), sec. 3, "Powers of
                 Council", printed pp. 11-12, is the clause Virginia enacted
                 for Arlington in 1952 (vaacts1952c443) and the ancestor of
                 today's sec. 15.2-703: "Neither the council nor any of its
                 committees or members shall dictate the appointment of any
                 person to office or employment by the city manager, or in any
                 manner interfere with the city manager or prevent him from
                 exercising his own judgment in the appointment of officers and
                 employes in the administrative service. Except for the purpose
                 of inquiry the council and its members shall deal with the
                 administrative service solely through the city manager, and
                 neither the council nor any member thereof shall give orders
                 to any of the subordinates of the city manager, either
                 publicly or privately." The model carries a penalty too, which
                 the 1952 act kept and today's section has dropped: "Any such
                 dictation, prevention, orders, or other interference on the
                 part of a member of council with the administration of the
                 city shall be deemed to be a misdemeanor", on conviction a
                 fine, imprisonment "or both, and to removal from office in the
                 discretion of the court", the amounts left blank for the
                 adopting city to fill in. Sec. 4 forbids a member of the
                 council being chosen as manager. The model has no sentence
                 letting the council discuss appointments with the manager:
                 that carve-out is later (richland1958charter). The same clause
                 stands behind the Alexandria, Richmond, Norfolk and Roanoke
                 charter provisions, and Norfolk reads broader than Arlington
                 because it keeps the second sentence whole. Filed in Drive as
                 "books/National Municipal League 1916 - A Model City Charter
                 and Municipal Home Rule.txt", the Internet Archive's OCR of
                 the printed volume, saved as published on 1 October 2026; the
                 text interleaves the printed line numbers, so the clause above
                 is given without them},
}

@legislation{vaacts1952c49,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1952 (ch. 49)},
  organization = {General Assembly of Virginia, session of 1952},
  date        = {1952-02-18},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280223t&seq=71},
  urldate     = {2026-10-01},
  note        = {Ch. 49, Acts of the General Assembly of Virginia, session of
                 1952, printed p. 67, approved 18 February 1952 [S 64]},
  annotation  = {The petition mechanism the whole 1952 package runs on, and the
                 first of the session's acts: everything after it refers back
                 to it, and it is what made the rest of the session optional
                 rather than self-executing. New sec. 15-360.1 provides that
                 where a referendum "is provided for by law", a petition
                 "signed by two hundred or more qualified voters of the county"
                 filed with the circuit court by 15 July obliges the court to
                 "issue and enter of record an order requiring the county
                 election officials to open the polls at the regular election
                 to be held in November of such year on the question stated in
                 such statute". A statute calling for a special election
                 instead needs a petition "signed by one thousand or more
                 qualified voters of the county", and the court must order the
                 poll within fifteen days for a date 45 to 90 days out. An
                 emergency clause puts the act in force from its passage. The
                 200-voter threshold is the one the Arlington League of Women
                 Voters met on 11 July 1952 with 204 signatures
                 (dailysun1952petitions), and the one no one met for the board-
                 size and four-year-term questions of vaacts1952c591. Filed in
                 Drive as "legal/state statutes/Commonwealth of Virginia 1952 -
                 Acts and Joint Resolutions, Session of 1952 (ch. 49).pdf", the
                 page text as HathiTrust umn.31951d02280223t serves it, set out
                 on a plain page by code/sources/pages.py and printed on 1
                 October 2026; HathiTrust refuses an automated request, so no
                 copy of the page image was had.},
}

@legislation{vaacts1952c162,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1952 (ch. 162)},
  organization = {General Assembly of Virginia, session of 1952},
  date        = {1952-02-29},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280223t&seq=180},
  urldate     = {2026-10-01},
  note        = {Ch. 162, Acts of the General Assembly of Virginia, session of
                 1952, printed p. 176, approved 29 February 1952 [H 326]},
  annotation  = {The Board's power of formal inquiry. New sec. 15-352.2: the
                 county board "shall have full power to inquire into the
                 official conduct of any office, officer or employee under its
                 control, and to investigate the accounts, receipts,
                 disbursements and expenses of any such office, officer or
                 employee"; for those purposes it may subpoena county employees
                 as witnesses, administer oaths and "require the production of
                 books, papers and other evidence in their control", and a
                 witness who refuses "shall be deemed guilty of a misdemeanor".
                 Read with vaacts1952c443 six weeks later this is one design
                 rather than two: the Board gains a formal power of inquiry and
                 loses its informal power of direction, and c. 443's exception
                 for the purpose of inquiry points at this section. The
                 Arlington Civic Federation's local government committee had
                 asked for exactly this power at the League of Women Voters'
                 institute on 29 September 1951 (dailysun1951institute). Note a
                 drafting collision: this act and vaacts1952c198 both add a
                 section numbered 15-352.2, one for investigations and one for
                 the Manager's term, which is why those subjects sit at secs.
                 15.2-709 and 15.2-708 today. Filed in Drive as "legal/state
                 statutes/Commonwealth of Virginia 1952 - Acts and Joint
                 Resolutions, Session of 1952 (ch. 162).pdf", the page text as
                 HathiTrust umn.31951d02280223t serves it, set out on a plain
                 page by code/sources/pages.py and printed on 1 October 2026;
                 HathiTrust refuses an automated request, so no copy of the
                 page image was had.},
}

@legislation{vaacts1952c198,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1952 (ch. 198)},
  organization = {General Assembly of Virginia, session of 1952},
  date        = {1952-03-06},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280223t&seq=230},
  urldate     = {2026-10-01},
  note        = {Ch. 198, Acts of the General Assembly of Virginia, session of
                 1952, printed pp. 226-228, approved 6 March 1952 [S 174]},
  annotation  = {The act that offered Arlington the strong-manager form and
                 left the choice to the voters. Sec. 15-352 keeps the Manager's
                 core grant, today's sec. 15.2-706 almost word for word: "The
                 administrative and executive powers of the county, including
                 the power of appointment of all officers and employees whose
                 appointment or election is not otherwise provided by law, are
                 vested in an official known as the county manager". Department
                 heads, however, "shall be selected by the county board;
                 provided that if a majority of the qualified voters voting in
                 the election required by § 15-355.1 vote in favor thereof,
                 then the heads of the several county departments ... shall be
                 appointed by the county manager." New sec. 15-352.2 sets the
                 Manager's term at one year - it "shall expire on June
                 thirtieth of each year after nineteen hundred fifty-two", with
                 sixty days' notice if his services are not wanted, and removal
                 only "for neglect of duty, malfeasance or misfeasance in
                 office, or incompetency" - unless the referendum carries,
                 after which he is "appointed for an indefinite period and be
                 subject to removal by the county board at any time", with a
                 written statement of reasons and a public hearing if he asks,
                 suspension capped at thirty days, and the Board's action "not
                 be subject to review". New sec. 15-355.1 prints the two
                 questions for 1952: "Shall the county manager be appointed for
                 an indefinite term, subject to removal at any time by the
                 county board?" and "Shall the heads of the county departments
                 be appointed by the county manager?", with sec. 15-360.1
                 (vaacts1952c49) supplying the machinery. Both carried on 4
                 November 1952 (dailysun1952results). Sec. 15-353 is amended on
                 the budget: the Manager prepares the tentative budget by 15
                 March, the Board may alter it only before 15 May, and if it
                 does not act the Manager's budget stands. Filed in Drive as
                 "legal/state statutes/Commonwealth of Virginia 1952 - Acts and
                 Joint Resolutions, Session of 1952 (ch. 198).pdf", the page
                 text as HathiTrust umn.31951d02280223t serves it, set out on a
                 plain page by code/sources/pages.py and printed on 1 October
                 2026; HathiTrust refuses an automated request, so no copy of
                 the page image was had.},
}

@legislation{vaacts1952c443,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1952 (ch. 443)},
  organization = {General Assembly of Virginia, session of 1952},
  date        = {1952-04-01},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280223t&seq=736},
  urldate     = {2026-10-01},
  note        = {Ch. 443, Acts of the General Assembly of Virginia, session of
                 1952, printed p. 732, approved 1 April 1952 [S 431]},
  annotation  = {The non-interference bar, and the one structural change of the
                 1952 session enacted outright rather than offered to the
                 voters. The act is titled as "relating to interference by
                 members of county boards in appointments and removals of
                 certain personnel". New sec. 15-350.1 in full: "Except as to
                 persons appointed by it, neither the county board nor any of
                 its members shall direct or request the appointment of any
                 person to or his removal from any office or employment by the
                 county or in any way take part in the appointment of or
                 removal of officers and employees of the county. Except for
                 the purpose of inquiry, the board and its members shall deal
                 with the administrative services solely through the county
                 manager and the heads of departments whom it may be empowered
                 to appoint and neither the board nor any member thereof shall
                 give orders either publicly or privately to any other county
                 employee. Any member violating the provisions of this section
                 shall be guilty of a misdemeanor and upon conviction thereof
                 shall forfeit his office." Four things separate that from
                 today's sec. 15.2-703, all of them loosening the Board:
                 requesting an appointment is no longer barred, only dictating
                 one; the bar on taking any part in an appointment is gone; the
                 misdemeanor and the forfeiture of office are gone; and a
                 sentence has been added letting the Board discuss appointments
                 and removals with the Manager. None of that happened in 1962
                 (vaacts1962c623) or in 1971 (vaacts1971exsess), which leaves 1982
                 c. 108 or the 1997 recodification. The wording follows the
                 National Municipal League's model (nml1916modelcharter),
                 penalty included. What prompted the act is unknown: it is in
                 neither the League of Women Voters' October 1951 list nor the
                 delegation's December 1951 bill list. Filed in Drive as
                 "legal/state statutes/Commonwealth of Virginia 1952 - Acts and
                 Joint Resolutions, Session of 1952 (ch. 443).pdf", the page
                 text as HathiTrust umn.31951d02280223t serves it, set out on a
                 plain page by code/sources/pages.py and printed on 1 October
                 2026; HathiTrust refuses an automated request, so no copy of
                 the page image was had.},
}

@legislation{vaacts1952c569,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1952 (ch. 569)},
  organization = {General Assembly of Virginia, session of 1952},
  date        = {1952-04-03},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280223t&seq=938},
  urldate     = {2026-10-01},
  note        = {Ch. 569, Acts of the General Assembly of Virginia, session of
                 1952, printed p. 934, approved 3 April 1952 [H 443]},
  annotation  = {The County Attorney, offered to the voters and never put to
                 them. New sec. 15-352.3 provides that in 1952 a county under
                 this form may hold a referendum on "Shall the position of
                 attorney to the County Board be created?" and, if it is
                 created, whether the attorney shall be "Elected by the people"
                 or "Appointed by the County Board", with sec. 15-360.1
                 (vaacts1952c49) supplying the machinery. On a yes the Board
                 fixes the compensation, "which shall not be less than thirty-
                 five hundred dollars, nor more than six thousand dollars". The
                 duties are to represent the Board "in any legal proceeding in
                 which the Board or any of its members are sued in their
                 official capacity", to give written opinions, to prepare and
                 codify ordinances and to attend all Board meetings, but
                 expressly not "bringing any suit or action on behalf of the
                 county board or its members"; no duty may conflict with the
                 Attorney for the Commonwealth's, who need no longer attend
                 Board meetings once the office exists. On appointment by the
                 Board the attorney "shall serve at the pleasure of the Board
                 but in no case shall his period of employment exceed one year
                 without renewal by a majority vote", and the Board may employ
                 only one attorney at a time. The office was on the League of
                 Women Voters' October 1951 list (dailysun1951institute) and in
                 the delegation's December bill list (dailysun1951bills), but
                 the question was not among the seven on the 4 November 1952
                 ballot (dailysun1952lwv), and Edmund D. Campbell was already
                 acting as the Board's counsel that autumn (paolicelli1952).
                 Filed in Drive as "legal/state statutes/Commonwealth of
                 Virginia 1952 - Acts and Joint Resolutions, Session of 1952
                 (ch. 569).pdf", the page text as HathiTrust
                 umn.31951d02280223t serves it, set out on a plain page by
                 code/sources/pages.py and printed on 1 October 2026;
                 HathiTrust refuses an automated request, so no copy of the
                 page image was had.},
}

@legislation{vaacts1952c591,
  author      = {{Commonwealth of Virginia}},
  title       = {Acts and Joint Resolutions, Session of 1952 (ch. 591)},
  organization = {General Assembly of Virginia, session of 1952},
  date        = {1952-04-03},
  url         = {https://babel.hathitrust.org/cgi/pt?id=umn.31951d02280223t&seq=1039},
  urldate     = {2026-10-01},
  note        = {Ch. 591, Acts of the General Assembly of Virginia, session of
                 1952, printed pp. 1035-1036, approved 3 April 1952 [H 650]},
  annotation  = {Board elections, offered to the voters and never petitioned
                 onto the ballot. The act re-enacts sec. 15-351, and subsection
                 (e) sets a hard window: a petition "signed by two hundred or
                 more qualified voters" filed with the circuit court "on or
                 before the first day of August, nineteen hundred fifty-two", a
                 court order "on or before the first day of September, nineteen
                 hundred fifty-two", and the vote "at the next regular election
                 to be held in November, nineteen hundred fifty-two". Two
                 questions were to be printed: "Shall the members of the county
                 board be elected biennially for four year terms, as provided
                 in subsection (f) of § 15-351 of the Code of Virginia?" and
                 "Shall the membership on the county board be increased from
                 five to seven?" Subsection (f) works out the staggering that a
                 yes would have produced, and subsection (g) provides that on a
                 yes to the second question "there shall be elected two
                 additional members of the board, for terms of three years" at
                 the November 1953 election. No petition was filed, so neither
                 question reached the ballot and the window closed; the seven-
                 member question reached Arlington voters in 1952 only as a
                 conditional clause of the incorporation package, which failed
                 (dailysun1952petitions, dailysun1952results). 1954
                 (vaacts1954c151) and 1958 (vaacts1958c207) reopened the window
                 and dropped the board-size question. At-large election is not
                 among the questions. Filed in Drive as "legal/state
                 statutes/Commonwealth of Virginia 1952 - Acts and Joint
