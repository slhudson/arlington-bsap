@online{rcva2025blockvoting,
  author      = {{Ranked Choice Virginia}},
  title       = {Block Voting in Charlottesville},
  organization = {Ranked Choice Virginia},
  date        = {2025-06-06},
  url         = {https://www.rankedchoiceva.org/news/block-voting-in-charlottesville-2025},
  urldate     = {2026-10-04},
  annotation  = {First of the five-part series on Charlottesville's former
                 block voting system (rcva2025blockvoting,
                 rcva2025wardstowinner, rcva2025revivingwards,
                 rcva2025reformfatigue, rcva2025fairrepresentation). Advocacy
                 writing, not a neutral history: the page carries no byline;
                 the series is Ranked Choice Virginia's own writing, and Sally
                 Hudson, this report's co-author, wrote it. Defines block
                 voting as each voter supporting as many candidates as there
                 are seats, so that the largest bloc picks every winner. Gives
                 two partisan cases, Harrisonburg in 2024 (Democrats 59 per
                 cent of the congressional vote and all three council seats)
                 and Lynchburg in 2022 (Republicans under 55 per cent of the
                 congressional vote and every at-large seat), with the page's
                 own links to the results. States, without a source on the
                 page, that a white majority bloc leaves racial minorities
                 underrepresented and a homeowner majority leaves renters
                 underrepresented, and that minority voters in such systems may
                 stop voting. Links FairVote's explainer (fairvoteblockvsrcv)
                 at "block voting", Berry and Dye's 1979 article in the Florida
                 State University Law Review (7, no. 1, pp. 85-122; not entered
                 here, its PDF could not be fetched) at "underrepresented", and
                 a Boston University-hosted PDF at "homeowners". Read
                 2026-10-04. Filed in sources as "other/rcva/Ranked Choice Virginia 2025 - Block Voting in Charlottesville.pdf", printed from the
                 page on 2026-10-04},
}

