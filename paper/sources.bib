% Bibliography for the Arlington BSaP report.
%
% One registry, shared by the prose and the data. The `source` column in
% data/clean/ holds a citekey from this file, so a claim in the report and a
% cell in a table point at the same entry. tests.py checks that every citekey
% used in data/clean/ exists here.
%
% Every entry is built from the document itself, not from memory. Where a
% detail could not be read off the document in hand, the entry says so in its
% `note` rather than carrying a plausible guess. docs/sources.md holds the
% prose about what each source can and cannot support.
%
% A source we cite but take no numbers from is not downloaded into data/raw/;
% its copy goes in the project's Drive folder, named for its citekey plus a
% subject word - rose1964_annexation.pdf. So a file in Drive, a footnote in the
% report and a cell in data/clean/ all carry the same string, and whether every
% cited source is actually filed is something you can check. docs/sources.md
% has the folder.
%
% `annotation` holds what we know about the document as evidence - what is
% missing from the copy we hold, what its compiler warns about. biblatex does
% not print it, so it stays in the repository for whoever works on the sources
% next, and the report's footnotes carry only the caveats a reader needs.
%
% Citekeys are lowercase author + year and are PINNED in Zotero: editing a
% field must never silently rename one, because the CSVs cite by key.

% ---------------------------------------------------------------- the roster

@report{oleary2010,
  author      = {O'Leary, Frank},
  title       = {The Electoral History of That Part of Alexandria County Now
                 Known as Arlington County, 1870--1920},
  institution = {Office of the Treasurer, Arlington County, Virginia},
  date        = {2010-03},
  version     = {2},
  annotation  = {Signed and dated March 2010 in the text; the PDF file held in
                 data/raw/ was created in May 2012 and is marked Version 2.
                 Compiled from the Alexandria Gazette and other newspapers;
                 O'Leary states that party affiliation is inferred and that
                 early record-keeping was ragged and incomplete},
}

@report{arlingtonelections2021,
  author      = {{Arlington County Office of Voter Registration and Elections}},
  title       = {Arlington County Election Results},
  institution = {Arlington County, Virginia},
  date        = {2021-11-18},
  annotation  = {The document's own title; the county's website called it
                 ``Candidate History, 1920--Present'', which is how the file in
                 data/raw/ is named. PDF metadata names Linda Lindberg. States
                 that it was compiled from Electoral Board records and
                 historical news sources, that early vote tallies are
                 incomplete, and that corrections are welcome. The county has
                 since taken it down},
}

