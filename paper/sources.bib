@misc{vollin1974,
  title       = {George Vollin, Jr., et al. v. Mills E. Godwin, et al.},
  note        = {U.S. District Court, Eastern District of Virginia, Alexandria
                 Division, Civil Action No. 173-74-A},
  date        = {1974},
  annotation  = {A civil rights suit to have Arlington's at-large voting system
                 declared unconstitutional and single-member districts ordered
                 in its place. The eight plaintiffs, from pratt1995 note 16,
                 are George Vollin, Jr., Delores Lurito, Harrison Douglas,
                 Ethel Tucker, Frank Walsh, Kay Lou Papanicoulas, Philip J.
                 Kaczmarek and Dora Curtis; pratt1995 p.31 reports that the
                 complaint stated they were "all from minority (Black and
                 Hispanic) or lower income neighborhoods". District Judge
                 Albert V. Bryan, Jr. heard the matter on 2 October 1974 and
                 dismissed it after several plaintiffs had testified, holding,
                 as pratt1995 p.31 quotes him, "Even assuming that there was
                 racial motivation behind the passage of the referendum in
                 1930, that happened so long ago that it can't be considered as
                 a background of racial discrimination which shifts any burden
                 to the defendants", and that "there is no showing here of any
                 actual impact on individual voting power as a result of the
                 multi-member (single) district". The plaintiffs appealed, the
                 Fourth Circuit affirmed and the Supreme Court refused to hear
                 the case. Court, division and docket number as pratt1995 notes
                 5 and 15 print them. samuel2026 note 13 reports the appeal as
                 Vollin v. Kimbel, 519 F.2d 790 (4th Cir. 1975). The filing
                 date and the opinions themselves have still not been read
                 here, so the holding is quoted at second hand},
}

